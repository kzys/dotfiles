#!/usr/bin/env python3
"""List directories past Claude Code sessions ran in, most recent first.

Reads ~/.claude/projects/*/*.jsonl and prints one line per directory as
tab-separated cwd, git branch, last-activity timestamp, and title. Sessions are
deduped by cwd, keeping only the most recent one.

With --pick, lets the user choose one with fzf and prints just the cwd.
"""

import glob
import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from herdr_project import claude


def last_cwd_record(f, tail=65536):
    """Return the last record with a cwd in f, or None.

    Records are appended chronologically and cwd never changes within a
    session, so the last few KB are enough; fall back to the whole file
    only if they contain no such record.
    """
    size = os.path.getsize(f)
    with open(f, "rb") as fh:
        fh.seek(max(0, size - tail))
        lines = fh.read().split(b"\n")
        if size > tail:
            lines = lines[1:]  # first line is probably cut off
    for line in reversed(lines):
        if b'"cwd"' not in line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if "cwd" in d:
            return d
    if size > tail:
        return last_cwd_record(f, size)
    return None


def latest_by_cwd():
    seen = {}
    pattern = os.path.expanduser("~/.claude/projects/*/*.jsonl")
    for f in glob.glob(pattern):
        try:
            d = last_cwd_record(f)
            if d is None:
                continue
            cwd, branch, ts = d["cwd"], d.get("gitBranch"), d.get("timestamp")
            if ts and (cwd not in seen or ts > seen[cwd][1]):
                seen[cwd] = (branch, ts, f)
        except OSError:
            continue
    # Titles take reading whole transcripts, so only the newest per cwd.
    for cwd, (branch, ts, f) in seen.items():
        try:
            seen[cwd] = (branch, ts, claude.title(Path(f)))
        except OSError:
            seen[cwd] = (branch, ts, "")
    return seen


def short_path(cwd):
    """Abbreviate cwd for display: ~ for $HOME and [name] for a worktree."""
    home = os.path.expanduser("~")
    if cwd == home or cwd.startswith(home + "/"):
        cwd = "~" + cwd[len(home):]
    repo, sep, name = cwd.partition("/.claude/worktrees/")
    if sep:
        cwd = f"{repo} [{name}]"
    return cwd


def pick(rows):
    """Let the user choose a row with fzf and return its cwd, or None."""
    cols = [(short_path(cwd), branch or "", title) for cwd, (branch, _, title) in rows]
    widths = [max(len(c[i]) for c in cols) for i in range(2)]
    lines = [
        f"{cwd}\t{path:<{widths[0]}}  {branch:<{widths[1]}}  {title}"
        for (cwd, _), (path, branch, title) in zip(rows, cols)
    ]
    fzf = subprocess.run(
        ["fzf", "--height=~7", "--no-sort", "--with-nth=2", "--delimiter=\t"],
        input="\n".join(lines),
        stdout=subprocess.PIPE,
        text=True,
    )
    if fzf.returncode != 0:
        sys.exit(fzf.returncode)
    return fzf.stdout.split("\t")[0]


def main():
    rows = sorted(latest_by_cwd().items(), key=lambda kv: kv[1][1], reverse=True)
    if "--pick" in sys.argv[1:]:
        print(pick(rows))
        return
    for cwd, (branch, ts, title) in rows:
        print(f"{cwd}\t{branch}\t{ts}\t{title}")


if __name__ == "__main__":
    main()
