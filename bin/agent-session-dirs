#!/bin/sh
# agent-session-dirs [--agent <claude|codex>] [--pick] lists the directories
# past agent sessions ran in, newest first, as tab-separated directory, git
# branch, last activity and title. With --pick, the user chooses one with
# fzf, and it prints just the directory.

agent=claude
pick=
while [ $# -gt 0 ]; do
    case $1 in
    --agent) agent=$2 && shift ;;
    --agent=*) agent=${1#--agent=} ;;
    --pick) pick=1 ;;
    esac
    shift
done
state=${XDG_STATE_HOME:-$HOME/.local/state}
listed=$(curl --silent --fail --max-time 30 --unix-socket "$state/herdr-project/run/server.sock" \
    "http://localhost/sessions?agent=$agent") || exit 1
rows=$(printf '%s' "$listed" | jq -r '.[] | [.cwd, .branch, .at, .title] | @tsv')
if [ -z "$pick" ]; then
    printf '%s\n' "$rows"
    exit
fi
picked=$(printf '%s\n' "$rows" | fzf --height=~7 --no-sort --delimiter='	' --with-nth=1,2,4) || exit
printf '%s\n' "$picked" | cut -f1
