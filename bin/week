#!/usr/bin/env python3
import datetime
import sys

HEADER = 'Mo Tu We Th Fr Sa Su'
SEP = '   '
USAGE = 'usage: week [-N]'


def parse_count(argv):
    """Number of weeks asked for on the command line."""
    if not argv:
        return 1
    arg = argv[0]
    if not (arg.startswith('-') and arg[1:].isdigit()):
        raise ValueError(USAGE)
    return int(arg[1:])


def calendar(today, count=1, color=False):
    """Render count weeks side by side, with today's week in the middle."""
    monday = today - datetime.timedelta(days=today.weekday())
    offset = -(count // 2)
    weeks = [
        [monday + datetime.timedelta(weeks=offset + i, days=j) for j in range(7)]
        for i in range(count)
    ]

    month = weeks[0][0].strftime('%b')
    indent = ' ' * (len(month) + 1)

    rows = []
    for week in weeks:
        parts = []
        for d in week:
            s = f'{d.day:2d}'
            if d == today and color:
                s = f'\033[7m{s}\033[0m'
            parts.append(s)
        rows.append(' '.join(parts))

    return '\n'.join([
        indent + SEP.join(HEADER for _ in weeks),
        month + ' ' + SEP.join(rows),
    ])


def main(argv):
    try:
        count = parse_count(argv)
    except ValueError as e:
        print(e, file=sys.stderr)
        return 1
    print(calendar(datetime.date.today(), count, sys.stdout.isatty()))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
