#!/usr/bin/env python3
import datetime
import sys

count = 1
if len(sys.argv) > 1:
    arg = sys.argv[1]
    if arg.startswith('-') and arg[1:].isdigit():
        count = int(arg[1:])
    else:
        print(f'usage: week [-N]', file=sys.stderr)
        sys.exit(1)

today = datetime.date.today()
current_monday = today - datetime.timedelta(days=today.weekday())

offset = -(count // 2)
weeks = [
    [current_monday + datetime.timedelta(weeks=offset + i, days=j) for j in range(7)]
    for i in range(count)
]

color = sys.stdout.isatty()
sep = '   '

month = weeks[0][0].strftime('%b')
indent = ' ' * (len(month) + 1)

print(indent + sep.join('Mo Tu We Th Fr Sa Su' for _ in weeks))

rows = []
for week in weeks:
    parts = []
    for d in week:
        s = f'{d.day:2d}'
        if d == today and color:
            s = f'\033[7m{s}\033[0m'
        parts.append(s)
    rows.append(' '.join(parts))
print(month + ' ' + sep.join(rows))
