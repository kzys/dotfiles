#!/usr/bin/env python3
"""Pick a project under ~/project, one of its agent sessions, or a new
project with fzf. Each project is listed with the title from the front
matter of its README.md, followed by its sessions, newest first, with
their titles. Sessions running in Herdr are marked.

Enter on a running session switches to its pane. On any other session
it resumes that session, and on a project it starts a new one, in a new
tab of the project's workspace, or in a new workspace labeled with the
name from the front matter. A session running in the background is
stopped and resumed if idle, and attached otherwise.
"""

import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path

from herdr_agent import agent, codex_context, codex_sessions

HERDR = os.environ.get("HERDR_BIN_PATH", "herdr")
BIN = Path(__file__).resolve().parent
AGENT = agent()
CODEX_SESSIONS = codex_sessions() if AGENT == "codex" else []
PROJECTS = Path.home() / "project"
FRONT_MATTER = BIN / "herdr-front-matter"

# What fzf shows in its header for the highlighted row, whose fields
# are {1} kind and {4} display text.
HEADER = """case {1} in
    new) echo "enter: start a new session in a new project" ;;
    project) echo "enter: start a new session in this project" ;;
    *) case {4} in
        *●*) echo "enter: switch to this running session" ;;
        *) echo "enter: resume this session" ;;
    esac ;;
esac"""


def herdr(*args):
    """Runs herdr with args and returns its parsed JSON output. Output
    that isn't JSON counts as {}."""
    out = subprocess.run(
        [HERDR, *args], capture_output=True, text=True, check=True
    ).stdout
    try:
        return json.loads(out)
    except ValueError:
        return {}


def front_matter(directory, key):
    """Returns field key from the front matter of the notes in directory,
    or None if there are no notes."""
    proc = subprocess.run(
        [FRONT_MATTER, str(directory), key], capture_output=True, text=True
    )
    return proc.stdout.strip() if proc.returncode == 0 else None


def sessions(directory):
    """Returns the transcripts of the claude sessions in directory,
    newest first. Claude keeps them under ~/.claude/projects, in a
    directory named after the path."""
    if AGENT == "codex":
        return [s for s in CODEX_SESSIONS if s["cwd"] == str(directory)]
    named = re.sub("[^a-zA-Z0-9]", "-", str(directory))
    transcripts = (Path.home() / ".claude/projects" / named).glob("*.jsonl")
    return sorted(transcripts, key=lambda p: p.stat().st_mtime, reverse=True)


def title(transcript):
    """Returns the title of the session in transcript: the one it was
    renamed to, the one claude generated, or else its first prompt."""
    if AGENT == "codex":
        return " ".join((transcript.get("name") or transcript.get("title") or
                         transcript.get("first_user_message") or "(untitled)").split())[:60]
    data = transcript.read_bytes()

    def field(marker, key, find):
        """Returns key from the first or last line containing marker."""
        i = find(marker)
        if i < 0:
            return None
        start = data.rfind(b"\n", 0, i) + 1
        end = data.find(b"\n", i)
        try:
            return json.loads(data[start : end if end >= 0 else None]).get(key)
        except ValueError:
            return None

    for marker, key in (
        (b'"type":"custom-title"', "customTitle"),
        (b'"type":"ai-title"', "aiTitle"),
    ):
        if value := field(marker, key, data.rfind):
            return value
    prompt = field(b'"lastPrompt"', "lastPrompt", data.find) or ""
    return " ".join(str(prompt).split())[:60] or "(untitled)"


def context(directory, sid):
    """Returns the context window usage of session sid, as the
    statusline left it in directory, or "" if it didn't."""
    try:
        used = json.loads((directory / f"{AGENT}-{sid}.json").read_text())
        return f"{int(used['used_percentage'])}%"
    except (OSError, ValueError, KeyError, TypeError):
        return ""


def background(sid):
    """Returns the ID and status of claude session sid if it runs in
    the background, else None."""
    if AGENT == "codex":
        return None
    try:
        proc = subprocess.run(
            ["claude", "agents", "--json"], capture_output=True, text=True
        )
        agents = json.loads(proc.stdout)
        for a in agents:
            if a.get("kind") == "background" and a.get("sessionId") == sid:
                return a["id"], a.get("status")
    except (OSError, ValueError, AttributeError, TypeError, KeyError):
        pass
    return None


def choices(panes):
    """Returns the lines for fzf. Fields: kind, directory, session, then
    what fzf shows. Directory names start with the date, so reverse
    order puts the newest projects first."""
    running = {p["session"] for p in panes
               if p["session"] and p["agent"] == AGENT}
    lines = ["new\t\t\t+ new project"]
    for d in sorted(
        (d for d in PROJECTS.iterdir() if d.is_dir() and d.name[0] != "."),
        reverse=True,
    ):
        summary = front_matter(d, "title")
        if summary is None:
            summary = "(no notes)"
        elif not summary:
            summary = "(no title)"
        lines.append(f"project\t{d}\t\t{d.name}  {summary}")
        for t in sessions(d):
            sid = t["id"] if AGENT == "codex" else t.stem
            updated = t["updated_at"] if AGENT == "codex" else t.stat().st_mtime
            mark = "●" if sid in running else " "
            when = datetime.fromtimestamp(updated).strftime("%m-%d %H:%M")
            ctx = context(d, sid)
            if AGENT == "codex" and not ctx:
                pct = codex_context(t["rollout_path"])
                ctx = f"{pct}%" if pct is not None else ""
            lines.append(
                f"session\t{d}\t{sid}\t  {mark} {when} {ctx:>4}  {title(t)}"
            )
    return lines


def pick(lines):
    """Returns the fields of the line the user picks with fzf, or None."""
    proc = subprocess.run(
        [
            "fzf", "--reverse", "--delimiter=\t", "--with-nth=4..",
            "--prompt=project> ",
            "--header=enter: open a session, or start one in a project",
            f"--bind=focus:transform-header({HEADER})",
            "--preview=cd {2} 2>/dev/null && cat README.md NOTES.md AGENT-*.md 2>/dev/null",
            "--preview-window=down,50%",
        ],
        input="\n".join(lines),
        stdout=subprocess.PIPE,
        text=True,
    )
    if proc.returncode != 0:
        return None
    return proc.stdout.rstrip("\n").split("\t")


def main():
    PROJECTS.mkdir(exist_ok=True)
    panes = [
        {
            "agent": p.get("agent"),
            "workspace": p["workspace_id"],
            "cwd": p["cwd"],
            "pane": p["pane_id"],
            "session": (p.get("agent_session") or {}).get("value") or "",
        }
        for p in herdr("pane", "list")["result"]["panes"]
    ]

    picked = pick(choices(panes))
    if picked is None:
        return
    kind, directory, sid = picked[:3]
    if kind == "new":
        directory = tempfile.mkdtemp(
            prefix=datetime.now().strftime("%Y%m%d-"), dir=PROJECTS
        )

    cmd = f"HERDR_PROJECT_AGENT={AGENT} " + shlex.quote(str(BIN / "herdr-project"))
    if sid:
        for p in panes:
            if p["agent"] == AGENT and p["session"] == sid:
                herdr("agent", "focus", p["pane"])
                return
        bg = background(sid)
        if bg and bg[1] == "idle" and subprocess.run(
            ["claude", "stop", bg[0]], stdout=subprocess.DEVNULL
        ).returncode == 0:
            cmd += f" --resume {shlex.quote(sid)}"
        elif bg:
            cmd = f"claude attach {shlex.quote(bg[0])}"
        else:
            cmd += f" --resume {shlex.quote(sid)}"

    workspace = next(
        (
            p["workspace"]
            for p in panes
            if p["cwd"] == directory or p["cwd"].startswith(directory + "/")
        ),
        None,
    )
    if workspace:
        created = herdr(
            "tab", "create", "--workspace", workspace, "--cwd", directory, "--focus"
        )
    else:
        name = front_matter(directory, "name")
        label = ["--label", name] if name else []
        created = herdr(
            "workspace", "create", "--cwd", directory, *label, "--focus"
        )
        workspace = created["result"]["workspace"]["workspace_id"]
    subprocess.run([FRONT_MATTER, "--report", workspace, directory])
    herdr("pane", "run", created["result"]["root_pane"]["pane_id"], cmd)


if __name__ == "__main__":
    main()
