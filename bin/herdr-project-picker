#!/usr/bin/env python3
"""Pick a project under ~/project, one of its agent sessions, or a new
project. Each project is listed with the title from the front
matter of its README.md, followed by its sessions, newest first, with
their titles. Sessions running in Herdr are marked. Typing filters the
list: every word must appear in a project row, or in a session row or
its project's row.

Enter on a running session switches to its pane. On any other session
it resumes that session, and on a project it starts a new one, in a new
tab of the project's workspace, or in a new workspace labeled with the
name from the front matter. A session running in the background is
stopped and resumed if idle, and attached otherwise.

Closed projects, whose README.md front matter has a closed field, come
after the others with no agent running in Herdr.

With --inbox it lists instead what waits on the user in each open project:
items its agents' notes tag [you], untagged ones that likely do (marked
"you?"), and what herdr-project --watch found, as herdr-project-web,
which the watcher runs, serves them. Enter on one switches to
or resumes the session of the agent whose item it is, or that worked on
the project last, and on one without a project starts a new project.
Projects that look finished are listed with a suggestion to close them.
"""

import json
import os
import shlex
import subprocess
import sys
import urllib.request
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from herdr_project import claude
from herdr_project.agent import agent, codex_context, codex_sessions
from herdr_project.herdr import herdr
from herdr_project.instructions import new_project
from herdr_project.notes import front_matter, notes, report_title, reported_role
from herdr_project.screen import pick

BIN = Path(__file__).resolve().parent
PROJECTS = Path.home() / "project"


def sessions(directory, selected, codex):
    """Returns the sessions of the selected agent in directory, newest
    first: transcripts for claude, or Codex's records, from codex."""
    if selected == "codex":
        return [s for s in codex if s["cwd"] == str(directory)]
    return claude.transcripts(directory)


def row_notes(kind, directory, sid, selected):
    """Returns the notes to show for a row: those of the session's role
    for a claude session that reported one, else all of the project's."""
    role = None
    if kind == "session" and selected != "codex":
        role = reported_role(claude.transcript_dir(directory) / f"{sid}.jsonl")
    return notes(directory, role)


def title(transcript, selected):
    """Returns the title of the selected agent's session in transcript."""
    if selected == "codex":
        return " ".join((transcript.get("name") or transcript.get("title") or
                         transcript.get("first_user_message") or "(untitled)").split())[:60]
    return claude.title(transcript) or "(untitled)"


def context(directory, sid, selected):
    """Returns the context window usage of the selected agent's session
    sid, as the statusline left it in directory, or "" if it didn't."""
    try:
        used = json.loads((directory / f"{selected}-{sid}.json").read_text())
        return f"{int(used['used_percentage'])}%"
    except (OSError, ValueError, KeyError, TypeError):
        return ""


def background(sid, selected, run=subprocess.run):
    """Returns the ID and status of claude session sid if it runs in
    the background, else None. run runs a command like subprocess.run."""
    if selected == "codex":
        return None
    try:
        proc = run(["claude", "agents", "--json"], capture_output=True, text=True)
        agents = json.loads(proc.stdout)
        for a in agents:
            if a.get("kind") == "background" and a.get("sessionId") == sid:
                return a["id"], a.get("status")
    except (OSError, ValueError, AttributeError, TypeError, KeyError):
        pass
    return None


def choices(panes, selected, projects, codex):
    """Yields the lines for pick, for the projects in directory projects
    and the selected agent's sessions, with codex holding Codex's. Fields:
    kind, directory, session, then what pick shows. Projects with an
    agent running in Herdr panes come first. Directory names start with
    the date, so reverse order puts the newest projects first."""
    running = {p["session"] for p in panes
               if p["session"] and p["agent"] == selected}
    active = {p["cwd"] for p in panes if p["agent"] == selected}

    def has_agent(d):
        """Returns whether an agent runs in d or under it."""
        return any(c == str(d) or c.startswith(f"{d}/") for c in active)

    yield "new\t\t\t+ new project"
    for d in sorted(
        (d for d in projects.iterdir() if d.is_dir() and d.name[0] != "."),
        key=lambda d: (has_agent(d), not front_matter(d, "closed"), d.name),
        reverse=True,
    ):
        summary = front_matter(d, "title")
        if summary is None:
            summary = "(no notes)"
        elif not summary:
            summary = "(no title)"
        if front_matter(d, "closed"):
            summary += " (closed)"
        yield f"project\t{d}\t\t{d.name}  {summary}"
        for t in sessions(d, selected, codex):
            sid = t["id"] if selected == "codex" else t.stem
            updated = t["updated_at"] if selected == "codex" else t.stat().st_mtime
            mark = "●" if sid in running else " "
            when = datetime.fromtimestamp(updated).strftime("%m-%d %H:%M")
            ctx = context(d, sid, selected)
            if selected == "codex" and not ctx:
                pct = codex_context(t["rollout_path"])
                ctx = f"{pct}%" if pct is not None else ""
            yield f"session\t{d}\t{sid}\t  {mark} {when} {ctx:>4}  {title(t, selected)}"


# How inbox rows show where an item comes from.
SOURCES = {"you": "you", "?": "you?", "maybe": "maybe", "close": "close?", "pr": "pr",
           "slack": "slack", "linear": "linear", "ctx": "ctx", "idle": "idle"}


def session_for(directory, role, panes, selected, codex):
    """Returns the session of the selected agent in directory to open
    for an item of role, or "" if there is none: the one running in a
    pane with role, else, for claude, the newest that reported role,
    else the newest. Without a role it is the newest, which may not be
    the one running."""
    for p in panes:
        if (p["agent"] == selected and p["session"] and role and p["role"] == role
                and (p["cwd"] == str(directory) or p["cwd"].startswith(f"{directory}/"))):
            return p["session"]
    found = sessions(directory, selected, codex)
    if not found:
        return ""
    if selected == "codex":
        return found[0]["id"]
    if role:
        for t in found:
            if reported_role(t) == role:
                return t.stem
    return found[0].stem


def server_state(port):
    """Returns the state herdr-project-web on localhost port serves, or
    None if it doesn't answer with one."""
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/state", timeout=2) as r:
            state = json.load(r)
    except (OSError, ValueError):
        return None
    if not (isinstance(state, dict) and isinstance(state.get("projects"), list)
            and isinstance(state.get("unowned"), list)):
        return None
    return state


def inbox_choices(panes, selected, codex, state):
    """Yields the lines for pick, as choices does, for what waits on the
    user in state, what herdr-project-web serves, or None if it isn't
    running: the items of its projects, newest first, then those
    without a project."""
    if state is None:
        yield ("error\t\t\therdr-project-web isn't answering; herdr-project --watch "
               "runs it, logging to ~/.local/state/herdr-project/web.log")
        return
    running = {p["session"] for p in panes if p["session"] and p["agent"] == selected}
    for project in sorted(state["projects"], key=lambda p: p["dir"], reverse=True):
        if not project["items"]:
            continue
        d = Path(project["dir"])
        yield f"project\t{d}\t\t{d.name}  {project['title']}"
        sids = {}
        for i in project["items"]:
            if i["role"] not in sids:
                sids[i["role"]] = session_for(d, i["role"], panes, selected, codex)
            sid = sids[i["role"]]
            mark = "●" if sid in running else " "
            yield f"session\t{d}\t{sid}\t  {mark} {SOURCES.get(i['mark'], i['mark']):<6} {i['text']}"
    for i in state["unowned"]:
        yield f"new\t\t\t+ {SOURCES.get(i['mark'], i['mark']):<6} {i['text']}"


def main():
    selected = agent()
    codex = codex_sessions() if selected == "codex" else []
    PROJECTS.mkdir(exist_ok=True)
    panes = pane_records(herdr("pane", "list"))

    if sys.argv[1:] == ["--inbox"]:
        rows = inbox_choices(panes, selected, codex,
                             server_state(os.environ.get("PORT", "9000")))
    else:
        rows = choices(panes, selected, PROJECTS, codex)
    picked = pick(rows, lambda *row: row_notes(*row, selected))
    if picked is not None:
        open_picked(picked, panes, selected, PROJECTS, herdr)


def pane_records(listed):
    """Returns the panes in the output of herdr pane list, each with its
    agent, workspace, cwd, pane ID, agent session ID, or "", and the
    role its agent reported, or ""."""
    return [
        {
            "agent": p.get("agent"),
            "workspace": p["workspace_id"],
            "cwd": p["cwd"],
            "pane": p["pane_id"],
            "session": (p.get("agent_session") or {}).get("value") or "",
            "role": (p.get("tokens") or {}).get("role") or "",
        }
        for p in listed["result"]["panes"]
    ]


def open_picked(picked, panes, selected, projects, herdr):
    """Opens the picked row, (kind, directory, session), with the
    selected agent: switches to the pane among panes running its session,
    or starts the agent in a new tab of the project's workspace or in a
    new workspace, creating a project under projects for a new one. herdr
    runs a herdr command."""
    kind, directory, sid = picked[:3]
    if kind == "error":
        return
    if kind == "new":
        directory = str(new_project(projects, datetime.now()))

    cmd = f"HERDR_PROJECT_AGENT={selected} " + shlex.quote(str(BIN / "herdr-project"))
    if sid:
        for p in panes:
            if p["agent"] == selected and p["session"] == sid:
                herdr("agent", "focus", p["pane"])
                return
        bg = background(sid, selected)
        if bg and bg[1] == "idle" and subprocess.run(
            ["claude", "stop", bg[0]], stdout=subprocess.DEVNULL
        ).returncode == 0:
            cmd += f" --resume {shlex.quote(sid)}"
        elif bg:
            cmd = f"claude attach {shlex.quote(bg[0])}"
        else:
            cmd += f" --resume {shlex.quote(sid)}"

    workspace = next(
        (
            p["workspace"]
            for p in panes
            if p["cwd"] == directory or p["cwd"].startswith(directory + "/")
        ),
        None,
    )
    if workspace:
        created = herdr(
            "tab", "create", "--workspace", workspace, "--cwd", directory, "--focus"
        )
    else:
        name = front_matter(directory, "name")
        label = ["--label", name] if name else []
        created = herdr(
            "workspace", "create", "--cwd", directory, *label, "--focus"
        )
        workspace = created["result"]["workspace"]["workspace_id"]
    if cmd.startswith("claude attach "):
        # Without herdr-project, nothing else reports the title.
        report_title(workspace, directory, herdr)
    herdr("pane", "run", created["result"]["root_pane"]["pane_id"], cmd)


if __name__ == "__main__":
    main()
