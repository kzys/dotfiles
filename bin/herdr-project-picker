#!/bin/sh
# herdr-project-picker [--inbox] picks a project, a session or what waits
# on the user, from the server, and opens it in Herdr.

here=$(dirname "$(readlink -f "$0")")
exec node --experimental-strip-types --disable-warning=ExperimentalWarning \
    "$here/../herdr-project-web/picker-main.ts" "$@"
