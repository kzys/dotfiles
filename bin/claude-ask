#!/bin/sh
# Start claude in a scratch directory under ~/project with instructions
# for finding checkouts, keeping notes, and naming the Herdr workspace.

set -eu

start=$(date '+%Y-%m-%d %H:%M %Z')

# Prints the instructions in claude-ask.md, filling in this session's
# directory and start time.
instructions() {
    sed -e "s|\$PWD|$PWD|g" -e "s|\$start|$start|g" "$(dirname "$0")/claude-ask.md"
}

# Herdr already tracks sessions, so keep them out of the background.
[ "${HERDR_ENV:-}" != 1 ] || export CLAUDE_CODE_DISABLE_AGENT_VIEW=1

exec claude --add-dir "$HOME/ws/dotfiles" --append-system-prompt "$(instructions)" "$@"
