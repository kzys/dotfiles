#!/usr/bin/env python3
"""Pick a project under ~/project, one of its agent sessions, or a new
project. Each project is listed with the title from the front
matter of its README.md, followed by its sessions, newest first, with
their agent and titles. Claude and Codex sessions appear together.
Sessions running in Herdr are marked. Typing filters the
list: every word must appear in a project row, or in a session row or
its project's row.

Enter on a running session switches to its pane. On any other session
it resumes that session with its own agent. On a project it starts the
agent the "+ new project" row shows selected, Claude unless switched
with left, right, ctrl-b or ctrl-f, in a new tab of the project's
workspace, or in a new workspace labeled with the name from the front
matter. A session running in the background is stopped and resumed if
idle, and attached otherwise.

Closed projects, whose README.md front matter has a closed field, come
after the others with no agent running in Herdr.

With --inbox it lists instead what waits on the user in each open project:
items its agents' notes tag [you], untagged ones that likely do (marked
"you?"), and what herdr-project --watch found, as herdr-project-web,
which the watcher runs, serves them. Enter on one switches to
or resumes the session of the agent whose item it is, or that worked on
the project last, and on one without a project starts a new project
with the agent it shows selected, as the "+ new project" row does.
Projects that look finished are listed with a suggestion to close them.

With --app it opens rows in the Herdr app instead of Herdr. --json,
--notes and --open let the app's native picker show and open the rows. It knows
which Claude sessions run there, but not which Codex or OpenCode ones.
"""

import argparse
import json
import os
import shlex
import subprocess
import sys
import urllib.request
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from herdr_project import app, claude
from herdr_project.agent import codex_context, codex_sessions
from herdr_project.herdr import herdr
from herdr_project.instructions import new_project
from herdr_project.notes import front_matter, notes, report_title, reported_role
from herdr_project.screen import pick

BIN = Path(__file__).resolve().parent
PROJECTS = Path.home() / "project"
# The agents a new session can start with, the default first.
AGENTS = ("claude", "codex", "opencode")


def sessions(directory, codex):
    """Returns Claude and Codex sessions in directory together, newest first."""
    found = [{"agent": "claude", "id": t.stem, "updated_at": t.stat().st_mtime, "source": t}
             for t in claude.transcripts(directory)]
    found.extend({"agent": "codex", "id": t["id"], "updated_at": t["updated_at"], "source": t}
                 for t in codex if t["cwd"] == str(directory))
    return sorted(found, key=lambda s: s["updated_at"], reverse=True)


def row_notes(kind, directory, session):
    """Returns the selected session's role notes, or all project notes."""
    role = None
    selected, _, sid = session.partition(":")
    if kind == "session" and selected == "claude" and sid:
        role = reported_role(claude.transcript_dir(directory) / f"{sid}.jsonl")
    return notes(directory, role)


def title(transcript, selected):
    """Returns the title of the selected agent's session in transcript."""
    if selected == "codex":
        return " ".join((transcript.get("name") or transcript.get("title") or
                         transcript.get("first_user_message") or "(untitled)").split())[:60]
    return claude.title(transcript) or "(untitled)"


def context(directory, sid, selected):
    """Returns the context window usage of the selected agent's session
    sid, as the statusline left it in directory, or "" if it didn't."""
    try:
        used = json.loads((directory / f"{selected}-{sid}.json").read_text())
        return f"{int(used['used_percentage'])}%"
    except (OSError, ValueError, KeyError, TypeError):
        return ""


def background(sid, selected, run=subprocess.run):
    """Returns the ID and status of claude session sid if it runs in
    the background, else None. run runs a command like subprocess.run."""
    if selected != "claude":
        return None
    try:
        proc = run(["claude", "agents", "--json"], capture_output=True, text=True)
        agents = json.loads(proc.stdout)
        for a in agents:
            if a.get("kind") == "background" and a.get("sessionId") == sid:
                return a["id"], a.get("status")
    except (OSError, ValueError, AttributeError, TypeError, KeyError):
        pass
    return None


def choices(panes, projects, codex):
    """Yields the lines for pick, for the projects in directory projects
    and both agents' sessions, with codex holding Codex's. Fields:
    kind, directory, agent:session, then what pick shows. Projects with an
    agent running in Herdr panes come first. Directory names start with
    the date, so reverse order puts the newest projects first."""
    running = {(p["agent"], p["session"]) for p in panes if p["session"]}
    active = {p["cwd"] for p in panes if p["agent"] in AGENTS}

    def has_agent(d):
        """Returns whether an agent runs in d or under it."""
        return any(c == str(d) or c.startswith(f"{d}/") for c in active)

    for d in sorted(
        (d for d in projects.iterdir() if d.is_dir() and d.name[0] != "."),
        key=lambda d: (has_agent(d), not front_matter(d, "closed"), d.name),
        reverse=True,
    ):
        summary = front_matter(d, "title")
        if summary is None:
            summary = "(no notes)"
        elif not summary:
            summary = "(no title)"
        if front_matter(d, "closed"):
            summary += " (closed)"
        yield f"project\t{d}\t\t{d.name}  {summary}"
        for record in sessions(d, codex):
            selected, sid, t = record["agent"], record["id"], record["source"]
            updated = record["updated_at"]
            mark = "●" if (selected, sid) in running else " "
            when = datetime.fromtimestamp(updated).strftime("%m-%d %H:%M")
            ctx = context(d, sid, selected)
            if selected == "codex" and not ctx:
                pct = codex_context(t.get("rollout_path", ""))
                ctx = f"{pct}%" if pct is not None else ""
            yield f"session\t{d}\t{selected}:{sid}\t  {mark} {selected:<8} {when} {ctx:>4}  {title(t, selected)}"


# How inbox rows show where an item comes from.
SOURCES = {"you": "you", "?": "you?", "maybe": "maybe", "close": "close?", "pr": "pr",
           "slack": "slack", "linear": "linear", "ctx": "ctx", "idle": "idle"}


def session_for(directory, role, panes, codex):
    """Returns agent:session for the role's running or saved session, else the newest."""
    for p in panes:
        if (p["agent"] in AGENTS and p["session"] and role
                and p["role"] == role
                and (p["cwd"] == str(directory) or p["cwd"].startswith(f"{directory}/"))):
            return f"{p['agent']}:{p['session']}"
    found = sessions(directory, codex)
    if role:
        for record in found:
            if record["agent"] == "claude" and reported_role(record["source"]) == role:
                return f"claude:{record['id']}"
    return f"{found[0]['agent']}:{found[0]['id']}" if found else ""


def server_state(port):
    """Returns the state herdr-project-web on localhost port serves, or
    None if it doesn't answer with one."""
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/state", timeout=2) as r:
            state = json.load(r)
    except (OSError, ValueError):
        return None
    if not (isinstance(state, dict) and isinstance(state.get("projects"), list)
            and isinstance(state.get("unowned"), list)):
        return None
    return state


def inbox_choices(panes, codex, state):
    """Yields the lines for pick, as choices does, for what waits on the
    user in state, what herdr-project-web serves, or None if it isn't
    running: the items of its projects, newest first, then those
    without a project."""
    if state is None:
        yield ("error\t\t\therdr-project-web isn't answering; herdr-project --watch "
               "runs it, logging to ~/.local/state/herdr-project/web.log")
        return
    running = {f"{p['agent']}:{p['session']}" for p in panes if p["session"]}
    for project in sorted(state["projects"], key=lambda p: p["dir"], reverse=True):
        if not project["items"]:
            continue
        d = Path(project["dir"])
        yield f"project\t{d}\t\t{d.name}  {project['title']}"
        sids = {}
        for i in project["items"]:
            if i["role"] not in sids:
                sids[i["role"]] = session_for(d, i["role"], panes, codex)
            sid = sids[i["role"]]
            mark = "●" if sid in running else " "
            selected = sid.partition(":")[0]
            yield f"session\t{d}\t{sid}\t  {mark} {selected:<8} {SOURCES.get(i['mark'], i['mark']):<6} {i['text']}"
    for i in state["unowned"]:
        yield f"new\t\t\t+ {SOURCES.get(i['mark'], i['mark']):<6} {i['text']}"


def tui_panes():
    """Returns the panes of Herdr, as pane_records does."""
    return pane_records(herdr("pane", "list"))


def load_choices(panes, projects, inbox=False, list_panes=None):
    """Loads rows in the screen's background thread, filling panes for
    opening sessions from list_panes, by default tui_panes."""
    projects.mkdir(exist_ok=True)
    if not inbox:
        yield "new\t\t\t+ new project"
    codex = codex_sessions()
    panes.extend((list_panes or tui_panes)())
    if inbox:
        yield from inbox_choices(panes, codex, server_state(os.environ.get("PORT", "9000")))
    else:
        yield from choices(panes, projects, codex)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--inbox", action="store_true")
    parser.add_argument("--app", action="store_true",
                        help="open the picked row in the Herdr app instead of Herdr")
    # For the Herdr app's native picker, which shows the rows itself.
    parser.add_argument("--json", action="store_true",
                        help="print the rows as JSON instead of picking one")
    parser.add_argument("--notes", nargs=3, metavar=("KIND", "DIR", "SESSION"),
                        help="print the notes of a row")
    parser.add_argument("--open", nargs=3, metavar=("KIND", "DIR", "SESSION"),
                        help="open a row in the Herdr app")
    parser.add_argument("--agent", choices=AGENTS, default=AGENTS[0],
                        help="the agent --open starts for a row without a session")
    options = parser.parse_args()
    if options.notes:
        print(row_notes(*options.notes))
        return
    if options.open:
        open_in_app(options.open, options.agent, app.panes(), PROJECTS, app.herdr_app)
        return
    panes = []
    list_panes = app.panes if options.app else None
    if options.json:
        rows = load_choices(panes, PROJECTS, options.inbox, list_panes)
        json.dump([line.split("\t", 3) for line in rows], sys.stdout)
        return
    picked = pick(load_choices(panes, PROJECTS, options.inbox, list_panes), row_notes, AGENTS)
    if picked is None:
        return
    if options.app:
        try:
            open_in_app(*picked, panes, PROJECTS, app.herdr_app)
        except (OSError, ValueError, subprocess.CalledProcessError) as e:
            # The app closes the picker's dialog when it exits, so wait
            # until the error is read.
            input(f"Couldn't open it: {e}\nPress Enter to close. ")
    else:
        open_picked(*picked, panes, PROJECTS, herdr)


def pane_records(listed):
    """Returns the panes in the output of herdr pane list, each with its
    agent, workspace, cwd, pane ID, agent session ID, or "", and the
    role its agent reported, or ""."""
    return [
        {
            "agent": p.get("agent"),
            "workspace": p["workspace_id"],
            "cwd": p["cwd"],
            "pane": p["pane_id"],
            "session": (p.get("agent_session") or {}).get("value") or "",
            "role": (p.get("tokens") or {}).get("role") or "",
        }
        for p in listed["result"]["panes"]
    ]


def plan(picked, agent, panes, projects):
    """Returns how to open the picked row, (kind, directory,
    agent:session), with its agent, or agent for a row without a
    session: ("focus", pane) for the pane among panes running its
    session, else ("start", workspace, directory, command) to run the
    command in a new tab of the project's workspace, or in a new
    workspace if workspace is None. Returns None for an error row.
    Creates a project under projects for a new one, and stops a
    background Claude session it resumes if the session is idle."""
    kind, directory, sid = picked[:3]
    if kind == "error":
        return None
    selected, sid = sid.split(":", 1) if sid else (agent, "")
    if kind == "new":
        directory = str(new_project(projects, datetime.now()))

    cmd = shlex.join([str(BIN / "herdr-project"), "--agent", selected])
    if sid:
        for p in panes:
            if p["agent"] == selected and p["session"] == sid:
                return "focus", p["pane"]
        bg = background(sid, selected)
        if bg and bg[1] == "idle" and subprocess.run(
            ["claude", "stop", bg[0]], stdout=subprocess.DEVNULL
        ).returncode == 0:
            cmd += f" --resume {shlex.quote(sid)}"
        elif bg:
            cmd = f"claude attach {shlex.quote(bg[0])}"
        else:
            cmd += f" --resume {shlex.quote(sid)}"

    workspace = next(
        (
            p["workspace"]
            for p in panes
            if p["cwd"] == directory or p["cwd"].startswith(directory + "/")
        ),
        None,
    )
    return "start", workspace, directory, cmd


def open_picked(picked, agent, panes, projects, herdr):
    """Opens the picked row in Herdr as plan says. herdr runs a herdr
    command."""
    planned = plan(picked, agent, panes, projects)
    if planned is None:
        return
    if planned[0] == "focus":
        herdr("agent", "focus", planned[1])
        return
    _, workspace, directory, cmd = planned
    if workspace:
        created = herdr(
            "tab", "create", "--workspace", workspace, "--cwd", directory, "--focus"
        )
    else:
        name = front_matter(directory, "name")
        label = ["--label", name] if name else []
        created = herdr(
            "workspace", "create", "--cwd", directory, *label, "--focus"
        )
        workspace = created["result"]["workspace"]["workspace_id"]
    if cmd.startswith("claude attach "):
        # Without herdr-project, nothing else reports the title.
        report_title(workspace, directory, herdr)
    herdr("pane", "run", created["result"]["root_pane"]["pane_id"], cmd)


def open_in_app(picked, agent, panes, projects, run):
    """Opens the picked row in the Herdr app as plan says, with panes
    from app.panes. run runs an app command with a dict of arguments."""
    planned = plan(picked, agent, panes, projects)
    if planned is None:
        return
    if planned[0] == "focus":
        run("pane.focus", {"terminal": planned[1]})
        return
    _, space, directory, cmd = planned
    args = {"folder": directory, "argv": shlex.split(cmd)}
    if space:
        run("tab.new", {"space": space, **args})
        return
    name = front_matter(directory, "name")
    run("space.new", {"name": name, **args} if name else args)


if __name__ == "__main__":
    main()
