#! /bin/bash
set -euo pipefail

# opencode's installer drops the binary here, outside PATH.
PATH=$PATH:$HOME/.opencode/bin

# Startup workarounds from anomalyco/opencode#14965. Both binaries read them.
export OTUI_PALETTE_IDLE_TIMEOUT_MS=${OTUI_PALETTE_IDLE_TIMEOUT_MS-1}
export OPENCODE_FAST_BOOT=${OPENCODE_FAST_BOOT-1}

# The 2.0 preview starts about twice as fast, so it is the default.
bin=opencode2
case "${1:-}" in
    -1) bin=opencode; shift ;;
    -2) shift ;;
esac

# Neither binary has a session picker, so -r mimics "claude --resume".
if [[ "${1:-}" != "-r" && "${1:-}" != "--resume" ]]; then
    exec "$bin" "$@"
fi
shift

# 1.x lists sessions itself. The preview keeps them in a table of its own and
# has no command to read it, so go to the database. That schema is not stable.
sessions() {
    if [[ "$bin" == opencode ]]; then
        opencode session list --format json | jq -r '.[] | "\(.id)\t\(.title)"'
        return
    fi

    python3 - "$PWD" <<'PYTHON'
import os, sqlite3, sys

share = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
db = os.path.join(share, "opencode", "opencode.db")
con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)

query = "select id, title from session_v2 %s order by time_updated desc"
rows = con.execute(query % "where directory = ?", (sys.argv[1],)).fetchall()
rows = rows or con.execute(query % "").fetchall()
for row in rows:
    print("%s\t%s" % row)
PYTHON
}

id=${1:-}
if [[ -n "$id" ]]; then
    shift
else
    id=$(sessions | fzf --no-sort | cut -f1) || exit
    [[ -n "$id" ]] || exit
fi

exec "$bin" --session "$id" "$@"
