#! /bin/bash
set -euo pipefail

# opencode's installer drops the binary here, outside PATH.
PATH=$PATH:$HOME/.opencode/bin

# -2 runs the 2.0 preview binary, which starts faster.
bin=opencode
if [[ "${1:-}" == "-2" ]]; then
    bin=opencode2
    shift
fi

# opencode takes a session id but has no picker, so -r mimics "claude --resume".
if [[ "${1:-}" != "-r" && "${1:-}" != "--resume" ]]; then
    exec "$bin" "$@"
fi
shift

if [[ "$bin" == opencode2 ]]; then
    echo "oc: opencode2 keeps its own sessions and cannot list them" >&2
    exit 1
fi

id=${1:-}
if [[ -n "$id" ]]; then
    shift
else
    id=$(opencode session list --format json |
             jq -r '.[] | "\(.id)\t\(.title)"' |
             fzf --no-sort |
             cut -f1) || exit
    [[ -n "$id" ]] || exit
fi

exec "$bin" --session "$id" "$@"
