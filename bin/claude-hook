#!/usr/bin/env python3
"""Claude Code hook for every event, which it reads from the input.

SessionStart: reports the session to the Herdr pane so that Herdr
resumes it after a restart, and, when a session resumes, reports the
role it last reported to its new pane and, in a project under
~/project, prints herdr-project's instructions, since claude keeps the
system prompt the session started with. On a resume it also logs the
input to ~/.cache/claude-hook.log, with any step that fails."""

import json
import os
import subprocess
import sys
import time
import traceback
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from herdr_project.herdr import ancestors, herdr, in_pane
from herdr_project.instructions import instructions, project_dir
from herdr_project.notes import reported_role

DOTFILES = Path(__file__).resolve().parent.parent


def session_start(data, seq):
    """Returns the arguments for herdr pane report-agent-session from
    the SessionStart data, or None if this session doesn't own the
    pane. seq orders the reports."""
    # Subagents have an agent_id; only the main session owns the pane.
    sid = data.get("session_id")
    if data.get("agent_id") or not sid or not isinstance(sid, str):
        return None
    args = ["--source", "herdr:claude", "--agent", "claude", "--seq", str(seq),
            "--agent-session-id", sid]
    transcript, source = data.get("transcript_path"), data.get("source")
    if transcript and isinstance(transcript, str):
        args += ["--agent-session-path", transcript]
    if source and isinstance(source, str):
        args += ["--session-start-source", source]
    return args


def resumed_instructions(data, projects, now):
    """Returns the instructions to add to the context of a main session
    resuming in a project under projects, from the SessionStart data,
    or None. now is when it resumed, which they give as its start."""
    cwd = data.get("cwd")
    if not resuming(data) or not isinstance(cwd, str):
        return None
    directory = project_dir(cwd, projects)
    if directory is None:
        return None
    return ("This session resumed. These instructions replace any earlier "
            "copy of them, and give the time it resumed as its start; skip "
            "the steps you already did, such as naming the workspace.\n\n"
            + instructions(directory, DOTFILES, now))


def resuming(data):
    """Reports whether the SessionStart data is of a main session
    resuming."""
    return data.get("source") == "resume" and not data.get("agent_id")


def report_session(data):
    """Reports the session in the SessionStart data to the Herdr pane
    it runs in, if any."""
    if not in_pane(os.environ, ancestors()):
        return
    args = session_start(data, time.time_ns())
    if args is not None:
        herdr("pane", "report-agent-session", os.environ["HERDR_PANE_ID"], *args,
              stderr=subprocess.DEVNULL)


def report_role(data):
    """Reports the role a session resuming, from the SessionStart data,
    last reported in its transcript to the Herdr pane it runs in, if
    any. A resumed session may run in a new pane, which has no role yet;
    a pane that has one keeps it, saving the scan of the transcript."""
    transcript = data.get("transcript_path")
    if not resuming(data) or not isinstance(transcript, str):
        return
    if not in_pane(os.environ, ancestors()):
        return
    pane = os.environ["HERDR_PANE_ID"]
    got = herdr("pane", "get", pane, stderr=subprocess.DEVNULL)
    if ((got.get("result") or {}).get("pane") or {}).get("tokens", {}).get("role"):
        return
    role = reported_role(transcript)
    if role is not None:
        herdr("pane", "report-metadata", pane, "--source", "agent-notes",
              "--token", f"role={role}", stderr=subprocess.DEVNULL)


def print_instructions(data):
    """Prints the instructions for a session resuming in a project, from
    the SessionStart data, to add them to its context."""
    text = resumed_instructions(data, Path.home() / "project", datetime.now().astimezone())
    if text is not None:
        print(text)


def log(text):
    """Appends text, with the time, to the hook's log in the cache
    directory, if it can be written."""
    try:
        path = Path.home() / ".cache" / "claude-hook.log"
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", errors="backslashreplace") as f:
            f.write(f"{datetime.now().astimezone().isoformat()} {text}\n")
    except OSError:
        pass


def main():
    data = json.load(sys.stdin)
    if data.get("hook_event_name") != "SessionStart":
        return
    if resuming(data):
        log(f"SessionStart source={data.get('source')} "
            f"transcript={data.get('transcript_path')} session={data.get('session_id')}")
    # No step may keep another from running.
    for step in (report_session, report_role, print_instructions):
        try:
            step(data)
        except Exception:  # noqa: BLE001
            log(f"{step.__name__} failed:\n{traceback.format_exc()}")


if __name__ == "__main__":
    try:
        main()
    except Exception:  # noqa: BLE001
        pass  # A hook must never interrupt a session.
