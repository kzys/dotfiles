#!/bin/sh
# Claude Code status line: prints context window usage, the model,
# effort, how long the prompt cache stays warm, and rate limit usage.
# Inside a Herdr pane it also reports context window usage, the last
# prompt, the model, and the working directory and branch as the pane's
# $ctx, $prompt, $model, $dir and $branch tokens for the agent panel,
# plus $bg when it runs as a background session.

input=$(cat)
pct=$(printf '%s' "$input" | jq -r '
  .context_window as $w
  | if $w.used_percentage != null then $w.used_percentage
    elif $w.current_usage != null and ($w.context_window_size // 0) > 0 then
      ($w.current_usage | (.input_tokens // 0) + (.cache_creation_input_tokens // 0)
        + (.cache_read_input_tokens // 0)) * 100 / $w.context_window_size
    else empty end
  | floor')

[ -n "$pct" ] || exit 0

if [ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ]; then
    # The transcript records each prompt as a "last-prompt" line; the
    # newest is near the end.
    transcript=$(printf '%s' "$input" | jq -r '.transcript_path // empty')
    prompt=
    if [ -f "$transcript" ]; then
        prompt=$(tail -c 262144 "$transcript" | grep -F '"lastPrompt"' |
            tail -n 1 | jq -r '.lastPrompt // empty | gsub("\\s+"; " ")')
    fi
    model=$(printf '%s' "$input" | jq -r '.model.display_name // empty')
    dir=$(printf '%s' "$input" | jq -r '.workspace.current_dir // .cwd // empty')
    branch=$(git -C "$dir" branch --show-current 2>/dev/null)
    case $dir in
    "$HOME"/*) dir="~${dir#"$HOME"}" ;;
    esac
    # A background session reports to the pane that started the daemon,
    # which may be showing a different session; $bg flags that.
    if "$(dirname "$0")/in-herdr-pane"; then
        set -- --clear-token bg
    else
        set -- --token bg="bg"
    fi
    herdr pane report-metadata "$HERDR_PANE_ID" --source claude-statusline \
        "$@" --token ctx="${pct}%" --token prompt="$prompt" \
        --token model="$model" \
        --token dir="$dir" --token branch="$branch" >/dev/null 2>&1
fi

# Kept within 80 columns. A part whose fields are missing or malformed
# is left out.
printf '%s' "$input" | jq -r --arg pct "$pct" '
  def part(f): first(f | strings)? // empty;
  def size: if . >= 1000000 then "\(. / 1000000)M" else "\(. / 1000 | floor)k" end;
  def clock: strflocaltime("%H:%M");
  . as $in
  | [
      part("\($pct)% of \(.context_window.context_window_size | numbers | size) ctx")
        // "\($pct)% ctx",
      part(.model.display_name | strings
        | . + (part($in.effort.level | strings | " (\(.))") // "")),
      part(.prompt_cache | objects
        | if .warm == true
          then "cache \((.expires_at | numbers) - now | . / 60 | floor)m"
          else "cache cold" end),
      part(.rate_limits.five_hour | objects
        | "5h \(.used_percentage | numbers | floor)% (\(.resets_at | numbers | clock))"),
      part(.rate_limits.seven_day | objects
        | "7d \(.used_percentage | numbers | floor)%")
    ] | join(" · ")'
