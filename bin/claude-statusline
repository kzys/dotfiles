#!/bin/sh
# Claude Code's status line, which herdr-project-web works out from the
# status it posts here. It shows nothing with the server down.

pane=
[ "$HERDR_ENV" = 1 ] && pane=$HERDR_PANE_ID
state=${XDG_STATE_HOME:-$HOME/.local/state}
curl --silent --max-time 2 --unix-socket "$state/herdr-project/run/server.sock" \
    --header "X-Herdr-Pane: $pane" --header "X-Agent-Pid: $$" \
    --header "Content-Type: application/json" --data-binary @- \
    http://localhost/statusline 2>/dev/null
exit 0
