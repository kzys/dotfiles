#!/bin/sh
# Claude Code status line: prints context window usage and, inside a
# Herdr pane, reports it, the last prompt, the model, and the working
# directory and branch as the pane's $ctx, $prompt, $model, $dir and
# $branch tokens for the agent panel, plus $bg when it runs as a
# background session.

input=$(cat)
pct=$(printf '%s' "$input" | jq -r '
  .context_window as $w
  | if $w.used_percentage != null then $w.used_percentage
    elif $w.current_usage != null and ($w.context_window_size // 0) > 0 then
      ($w.current_usage | (.input_tokens // 0) + (.cache_creation_input_tokens // 0)
        + (.cache_read_input_tokens // 0)) * 100 / $w.context_window_size
    else empty end
  | floor')

[ -n "$pct" ] || exit 0

if [ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ]; then
    # The transcript records each prompt as a "last-prompt" line; the
    # newest is near the end.
    transcript=$(printf '%s' "$input" | jq -r '.transcript_path // empty')
    prompt=
    if [ -f "$transcript" ]; then
        prompt=$(tail -c 262144 "$transcript" | grep -F '"lastPrompt"' |
            tail -n 1 | jq -r '.lastPrompt // empty | gsub("\\s+"; " ")')
    fi
    model=$(printf '%s' "$input" | jq -r '.model.display_name // empty')
    dir=$(printf '%s' "$input" | jq -r '.workspace.current_dir // .cwd // empty')
    branch=$(git -C "$dir" branch --show-current 2>/dev/null)
    case $dir in
    "$HOME"/*) dir="~${dir#"$HOME"}" ;;
    esac
    # A background session reports to the pane that started the daemon,
    # which may be showing a different session; $bg flags that.
    if "$(dirname "$0")/in-herdr-pane"; then
        set -- --clear-token bg
    else
        set -- --token bg="bg"
    fi
    herdr pane report-metadata "$HERDR_PANE_ID" --source claude-statusline \
        "$@" --token ctx="${pct}%" --token prompt="$prompt" \
        --token model="$model" \
        --token dir="$dir" --token branch="$branch" >/dev/null 2>&1
fi

printf 'ctx %s%%\n' "$pct"
