#!/bin/sh
# This script executes ~/.gitscript-[hostname of repository] before git(1).
#
# If you want to change your email address per repositories dynamically,
# please write like "export GIT_AUTHOR_EMAIL=alice@example.com".

real_git=/usr/bin/git

host=$($real_git config remote.origin.url | sed -e 's,^.*@\([^/:]*\).*$,\1,')
path=$HOME/.gitscript-$host

if test -f $path; then
    source $path
fi

exec $real_git "$@"
