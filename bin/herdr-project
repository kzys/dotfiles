#!/usr/bin/env python3
"""Start the selected agent in a scratch directory under ~/project with instructions
for finding checkouts, keeping notes, and naming the Herdr workspace.
In Herdr, the "## Remaining" section of the agent's notes shows in a
pane above it.

herdr-project --remaining <pane> runs in that pane: it reprints the
section of the agent in Herdr pane <pane>, whose notes file is named
by the role token the agent reports, until the pane is gone.
"""

import json
import os
import select
import shutil
import socket
import subprocess
import sys
import textwrap
import time
from datetime import datetime
from pathlib import Path

from herdr_agent import agent

HERDR = os.environ.get("HERDR_BIN_PATH", "herdr")
SELF = Path(__file__).resolve()


def herdr(*args):
    """Runs herdr with args and returns its parsed JSON output, or None
    if it fails. Output that isn't JSON counts as {}."""
    try:
        proc = subprocess.run(
            [HERDR, *args], capture_output=True, text=True, check=True
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    try:
        return json.loads(proc.stdout) if proc.stdout.strip() else {}
    except ValueError:
        return {}


def instructions():
    """Returns the instructions in herdr-project.md, filling in this
    session's directory and start time."""
    start = datetime.now().astimezone().strftime("%Y-%m-%d %H:%M %Z")
    text = (SELF.parent / "herdr-project.md").read_text()
    return text.replace("$PWD", os.getcwd()).replace("$start", start)


def remaining_section(role):
    """Returns the "## Remaining" section of AGENT-<role>.md, or a
    message saying why there is none."""
    if not role:
        return "Waiting for the agent to report its role."
    path = Path(f"AGENT-{role}.md")
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return f"No {path} yet."
    out = []
    in_section = False
    for line in lines:
        if line.startswith("## "):
            in_section = line == "## Remaining"
            if in_section:
                out.append(f"## Remaining: {role}")
                continue
        if in_section:
            out.append(line)
    return "\n".join(out) or f'No "## Remaining" section in {path} yet.'


class PaneWatch:
    """Learns from Herdr's socket when a pane closes, without polling.
    Without the socket it can only sleep, and the caller polls."""

    def __init__(self, pane):
        self.pane = pane
        self.buf = b""
        try:
            self.sock = socket.socket(socket.AF_UNIX)
            self.sock.connect(os.environ["HERDR_SOCKET_PATH"])
            request = {"id": "1", "method": "events.subscribe",
                       "params": {"subscriptions": [{"type": "pane.closed"}]}}
            self.sock.sendall(json.dumps(request).encode() + b"\n")
        except (OSError, KeyError):
            self.sock = None

    def closed(self, timeout):
        """Waits up to timeout seconds and returns whether the pane
        closed meanwhile."""
        if self.sock is None:
            time.sleep(timeout)
            return False
        deadline = time.monotonic() + timeout
        try:
            while (left := deadline - time.monotonic()) > 0:
                if not select.select([self.sock], [], [], left)[0]:
                    break
                data = self.sock.recv(65536)
                if not data:  # Herdr is gone.
                    return True
                *lines, self.buf = (self.buf + data).split(b"\n")
                for line in lines:
                    try:
                        if json.loads(line).get("data", {}).get("pane_id") == self.pane:
                            return True
                    except (ValueError, AttributeError):
                        pass
        except OSError:
            self.sock = None
            time.sleep(max(0, deadline - time.monotonic()))
        return False


def follow_remaining(pane):
    """Prints the "## Remaining" section of the agent in Herdr pane
    until the pane is gone, refreshing every few seconds. A failed read
    shows as a message rather than ending the loop, since that would
    close the pane."""
    watch = PaneWatch(pane)
    while (info := herdr("pane", "get", pane)) is not None:
        try:
            role = info["result"]["pane"]["tokens"].get("role") or ""
            out = remaining_section(role)
        except (KeyError, TypeError, AttributeError) as e:
            out = f"Cannot read the agent's role: {e!r}"
        # Wrap to the pane's width and cut to its height, with no final
        # newline, so that the top stays in view.
        cols, rows = shutil.get_terminal_size((80, 24))
        wrapped = []
        for line in out.splitlines() or [""]:
            wrapped += textwrap.wrap(
                line, cols, drop_whitespace=False, replace_whitespace=False
            ) or [""]
        sys.stdout.write("\033[H\033[2J" + "\n".join(wrapped[:rows]))
        sys.stdout.flush()
        if watch.closed(5):
            return


def remaining_pane():
    """Opens a pane above this one following this agent's "## Remaining"
    section, if this pane has its tab to itself."""
    env = os.environ
    panes = herdr("pane", "list", "--workspace", env["HERDR_WORKSPACE_ID"])
    tab = env["HERDR_TAB_ID"]
    if sum(p["tab_id"] == tab for p in panes["result"]["panes"]) != 1:
        return
    split = herdr(
        "pane", "split", "--current", "--direction", "down", "--ratio", "0.35",
        "--cwd", os.getcwd(), "--no-focus",
    )
    pane = ((split or {}).get("result", {}).get("pane", {})).get("pane_id")
    if not pane:
        return
    command = f"exec '{SELF}' --remaining {env['HERDR_PANE_ID']}"
    if herdr("pane", "run", pane, command) is None:
        herdr("pane", "close", pane)
        return
    herdr("pane", "swap", "--source-pane", pane,
          "--target-pane", env["HERDR_PANE_ID"])
    herdr("pane", "focus", "--direction", "down", "--pane", pane)


def main(argv):
    if argv[:1] == ["--remaining"]:
        if len(argv) != 2:
            print("usage: herdr-project --remaining <pane>", file=sys.stderr)
            return 2
        try:
            follow_remaining(argv[1])
        except KeyboardInterrupt:
            pass
        return 0

    selected = agent()

    # Herdr already tracks sessions, so keep them out of the background.
    if os.environ.get("HERDR_ENV") == "1":
        if selected == "claude":
            os.environ["CLAUDE_CODE_DISABLE_AGENT_VIEW"] = "1"
        try:
            remaining_pane()
        except (KeyError, TypeError):
            pass

    if selected == "codex":
        # --resume is the picker's common spelling; Codex uses a subcommand.
        if argv[:1] == ["--resume"]:
            argv = ["resume", *argv[1:]]
        rules = (SELF.parent.parent / "config/opencode/AGENTS.md").read_text()
        os.execvp("codex", [
            "codex", "--add-dir", str(SELF.parent.parent),
            "-c", "developer_instructions=" + json.dumps(rules + "\n\n" + instructions()),
            *argv,
        ])

    # Run claude's commands in bash, not the login shell, whose quirks
    # trip it up.
    os.environ["CLAUDE_CODE_SHELL"] = "/bin/bash"

    os.execvp("claude", [
        "claude", "--add-dir", str(Path.home() / "ws/dotfiles"),
        "--append-system-prompt", instructions(), *argv,
    ])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
