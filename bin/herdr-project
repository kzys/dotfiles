#!/bin/sh
# herdr-project [--agent <claude|codex|opencode>] [args...] starts the
# agent in its project, with instructions for working there, passing it
# args. A new session started outside ~/project gets a new project. The
# server works out how; this replaces itself with what it says, so that
# the agent is the pane's own process.

here=$(dirname "$(readlink -f "$0")")
case $1 in
--watch | --start-watch | --remaining) exec "$here/herdr-project-py" "$@" ;;
esac

for arg in "$@"; do
    set -- "$@" --data-urlencode "arg=$arg"
    shift
done
state=${XDG_STATE_HOME:-$HOME/.local/state}
script=$(curl --silent --fail-with-body --max-time 10 \
    --unix-socket "$state/herdr-project/run/server.sock" \
    --data-urlencode "cwd=$(pwd -P)" --data-urlencode "pid=$$" \
    --data-urlencode "herdr=${HERDR_ENV:-}" --data-urlencode "workspace=${HERDR_WORKSPACE_ID:-}" \
    "$@" http://localhost/launch) || {
    echo "herdr-project: ${script:-the server is not answering. herdr-project --watch runs it.}" >&2
    exit 1
}
eval "$script"
