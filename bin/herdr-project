#!/bin/sh
# herdr-project [--agent <claude|codex|opencode>] [args...] starts the
# agent in its project, with instructions for working there, passing it
# args. A new session started outside ~/project gets a new project. The
# server works out how; this replaces itself with what it says, so that
# the agent is the pane's own process.
#
# herdr-project --watch [<org>...] runs that server in this pane, watching
# the user's open pull requests, in the given GitHub organizations if any,
# with what else it watches: see herdr-project-web/server.ts.
#
# herdr-project --start-watch starts it in a new Herdr workspace named
# watch, unless a pane already has it.
#
# herdr-project --background starts it in the background, unless it
# runs. Starting an agent does that, and waits for it, if it isn't running.
#
# herdr-project --reply <token> <answer...> sends an agent's answer to a
# question the user asked every agent from the page, which gave it token.

here=$(dirname "$(readlink -f "$0")")
state=${XDG_STATE_HOME:-$HOME/.local/state}
case $1 in
--reply)
    [ $# -ge 3 ] || { echo "usage: herdr-project --reply <token> <answer...>" >&2; exit 2; }
    token=$2
    shift 2
    exec curl --silent --show-error --fail-with-body --max-time 10 \
        --unix-socket "$state/herdr-project/run/server.sock" \
        --data-urlencode "token=$token" --data-urlencode "text=$*" http://localhost/reply
    ;;
--watch | --start-watch | --background)
    WATCH_TTY=$(tty 2>/dev/null) && export WATCH_TTY
    exec node --experimental-strip-types --disable-warning=ExperimentalWarning \
        "$here/../herdr-project-web/watch/main.ts" "$@"
    ;;
esac

for arg in "$@"; do
    set -- "$@" --data-urlencode "arg=$arg"
    shift
done
ask() {
    script=$(curl --silent --fail-with-body --max-time 10 \
        --unix-socket "$state/herdr-project/run/server.sock" \
        --data-urlencode "cwd=$(pwd -P)" --data-urlencode "pid=$$" \
        --data-urlencode "herdr=${HERDR_ENV:-}" --data-urlencode "workspace=${HERDR_WORKSPACE_ID:-}" \
        "$@" http://localhost/launch)
}
ask "$@"
code=$?
# 7: nothing listens on the socket. A server that is only slow is left be,
# and --background leaves one that does listen be.
if [ "$code" = 7 ]; then
    echo "herdr-project: starting the server..." >&2
    "$0" --background
    tries=0
    # 56: the starting watcher dropped the connection before handing on
    # the socket.
    while { [ "$code" = 7 ] || [ "$code" = 56 ]; } && [ "$tries" -lt 60 ]; do
        sleep 0.5
        tries=$((tries + 1))
        ask "$@"
        code=$?
    done
fi
[ "$code" = 0 ] || {
    echo "herdr-project: ${script:-the server is not answering. See web.log and watch.log in ~/.local/state/herdr-project.}" >&2
    exit 1
}
eval "$script"
