#!/usr/bin/env python3
"""Start the selected agent in a scratch directory under ~/project with instructions
for finding checkouts, keeping notes, and naming the Herdr workspace.
In Herdr, the "## Remaining" section of the agent's notes shows in a
pane above it.

herdr-project --remaining <pane> runs in that pane: it reprints the
section of the agent in Herdr pane <pane>, whose notes file is named
by the role token the agent reports, until the pane is gone.

herdr-project --watch [<org>...] lists the user's open pull requests,
in the given GitHub organizations if any, active Slack conversations
and Linear issues. It tells the user, and the agent working on each pull
request, when its checks, review or state change, and the user when a
conversation or issue waits on them.
"""

import json
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from herdr_project.agent import agent
from herdr_project.herdr import herdr
from herdr_project.notes import report_title
from herdr_project import watch
from herdr_project.remaining import follow_remaining, remember_follower

SELF = Path(__file__).resolve()


def instructions():
    """Returns the instructions in herdr-project.md, filling in this
    session's directory, its start time and this checkout's directory."""
    start = datetime.now().astimezone().strftime("%Y-%m-%d %H:%M %Z")
    text = (SELF.parent / "herdr-project.md").read_text()
    return (text.replace("$PWD", os.getcwd()).replace("$start", start)
            .replace("$dotfiles", str(SELF.parent.parent)))


def remaining_pane():
    """Opens a pane above this one following this agent's "## Remaining"
    section, if this pane has its tab to itself. Raises if herdr fails,
    keeping its errors out of the agent's terminal."""
    env = os.environ

    def quiet(*args):
        return herdr(*args, stderr=subprocess.DEVNULL)

    panes = quiet("pane", "list", "--workspace", env["HERDR_WORKSPACE_ID"])
    tab = env["HERDR_TAB_ID"]
    if sum(p["tab_id"] == tab for p in panes["result"]["panes"]) != 1:
        return
    split = quiet(
        "pane", "split", "--current", "--direction", "down", "--ratio", "0.35",
        "--cwd", os.getcwd(), "--no-focus",
    )
    pane = split["result"]["pane"]["pane_id"]
    command = f"exec '{SELF}' --remaining {env['HERDR_PANE_ID']}"
    try:
        quiet("pane", "run", pane, command)
    except (OSError, subprocess.CalledProcessError):
        quiet("pane", "close", pane)
        raise
    remember_follower(pane, env["HERDR_PANE_ID"], env)
    quiet("pane", "swap", "--source-pane", pane,
          "--target-pane", env["HERDR_PANE_ID"])
    quiet("pane", "focus", "--direction", "down", "--pane", pane)


def main(argv):
    if argv[:1] == ["--remaining"]:
        if len(argv) != 2:
            print("usage: herdr-project --remaining <pane>", file=sys.stderr)
            return 2
        try:
            follow_remaining(
                argv[1], lambda *args: herdr(*args, stderr=subprocess.DEVNULL))
        except KeyboardInterrupt:
            pass
        return 0

    if argv[:1] == ["--watch"]:
        return watch.main(herdr, argv[1:])

    selected = agent()

    # Herdr already tracks sessions, so keep them out of the background.
    if os.environ.get("HERDR_ENV") == "1":
        if selected == "claude":
            os.environ["CLAUDE_CODE_DISABLE_AGENT_VIEW"] = "1"
        try:
            remaining_pane()
        except (KeyError, TypeError, OSError, subprocess.CalledProcessError):
            pass
        try:
            report_title(os.environ["HERDR_WORKSPACE_ID"], os.getcwd(),
                         lambda *args: herdr(*args, stderr=subprocess.DEVNULL))
        except (KeyError, OSError, subprocess.CalledProcessError):
            pass

    program, args, env = command(selected, argv)
    os.environ.update(env)
    os.execvp(program, args)


def command(selected, argv):
    """Returns the program and arguments that start the selected agent,
    passing it argv, and the environment variables to set for it."""
    if selected == "codex":
        # --resume is the picker's common spelling; Codex uses a subcommand.
        if argv[:1] == ["--resume"]:
            argv = ["resume", *argv[1:]]
        rules = (SELF.parent.parent / "config/opencode/AGENTS.md").read_text()
        # Codex doesn't expand imports, so give it a path it can open.
        rules = rules.replace("@../../", f"@{SELF.parent.parent}/")
        return "codex", [
            # Scratch projects may be untrusted, where Codex defaults to
            # read-only permissions and rejects additional writable roots.
            "codex", "--sandbox", "workspace-write",
            "--add-dir", str(SELF.parent.parent),
            "-c", "developer_instructions=" + json.dumps(rules + "\n\n" + instructions()),
            *argv,
        ], {}

    # Run claude's commands in bash, not the login shell, whose quirks
    # trip it up.
    return "claude", [
        "claude", "--add-dir", str(SELF.parent.parent),
        "--append-system-prompt", instructions(), *argv,
    ], {"CLAUDE_CODE_SHELL": "/bin/bash"}


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
