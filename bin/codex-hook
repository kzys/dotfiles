#!/usr/bin/env python3
"""Report Codex sidebar tokens alongside Herdr's built-in session hook."""

import json
import os
import subprocess
import sys
from pathlib import Path

from herdr_agent import codex_context, codex_sessions


def main():
    if os.environ.get('HERDR_ENV') != '1' or not os.environ.get('HERDR_PANE_ID'):
        return
    data = json.load(sys.stdin)
    sid = data.get('session_id')
    # A subagent or a Codex started by this thread doesn't own the pane.
    parent = os.environ.get('CODEX_THREAD_ID')
    if not sid or data.get('agent_id') or (parent and parent != sid):
        return
    directory = data.get('cwd', '')
    if not directory:
        return
    session = next((s for s in codex_sessions() if s['id'] == sid), {})
    prompt = data.get('prompt')
    if not prompt and data.get('hook_event_name') == 'SessionStart':
        prompt = session.get('title', '')
    pct = codex_context(data.get('transcript_path') or session.get('rollout_path', ''))
    branch = subprocess.run(['git', '-C', directory, 'branch', '--show-current'],
                            capture_output=True, text=True).stdout.strip()
    args = ['--clear-token', 'bg', '--token', f'cwd={directory}',
            '--token', f'dir={directory}', '--token', f'branch={branch}']
    if prompt:
        args += ['--token', 'prompt=' + ' '.join(prompt.split())[:200]]
    if session.get('model'):
        args += ['--token', 'model=' + session['model']]
    if pct is not None:
        args += ['--token', f'ctx={pct}%']
        project = session.get('cwd', directory)
        try:
            Path(project, f'codex-{sid}.json').write_text(json.dumps({'used_percentage': pct}))
        except OSError:
            pass
    elif data.get('hook_event_name') == 'SessionStart':
        args += ['--clear-token', 'ctx']
    subprocess.run([os.environ.get('HERDR_BIN_PATH', 'herdr'), 'pane', 'report-metadata',
                    os.environ['HERDR_PANE_ID'], '--source', 'codex-hook', *args],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, TypeError, KeyError):
        pass  # Reporting must never interrupt an agent turn.
