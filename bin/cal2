#! /usr/bin/env ruby
WIDTH = 10

def tomorrow(t)
  begin
    Time.local(t.year, t.month, t.day + 1)
  rescue ArgumentError
    if t.month < 12
      Time.local(t.year, t.month + 1, 1)
    else
      Time.local(t.year + 1, 1, 1)
    end
  end
end

def create_month_list(src)
  t = Time.local(src.year, src.month, 1)
  result = []

  while t.month == src.month
    result << t
    t = tomorrow(t)
  end

  result
end

def mail_count(d)
  (151.0 / (31 - 14)) * (31 - (d.day))
end

now = Time.now
month_list = create_month_list(now)

print (' ' * WIDTH) * month_list.first.wday
month_list.each do |d|
  printf('%3d%s(%3d) ',
         d.day,
         if now.day == d.day then '*' else ' ' end,
         mail_count(d))
  print "\n" if d.saturday?
end

print "\n" unless month_list.last.saturday?

