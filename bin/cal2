#! /usr/bin/env ruby
CYAN = "\033[36m"
REVERSE = "\e[7m"
RESET = "\033[0m"

def tomorrow(t)
  begin
    Time.local(t.year, t.month, t.day + 1)
  rescue ArgumentError
    if t.month < 12
      Time.local(t.year, t.month + 1, 1)
    else
      Time.local(t.year + 1, 1, 1)
    end
  end
end

def create_month_list(src)
  t = Time.local(src.year, src.month, 1)
  result = []

  while t.month == src.month
    result << t
    t = tomorrow(t)
  end

  result
end

def mail_count(d)
  (111.0 / (30 - 15)) * (30 - (d.day))
end

def create_calendar(t)
  month_list = create_month_list(t)
  rows = []
  columns = [nil] * month_list.first.wday

  month_list.each do |d|
    columns.push(d)
    if d.saturday?
      rows.push(columns)
      columns = []
    end
  end

  rows.push(columns)

  rows
end

now = Time.now
create_calendar(now).each do |columns|
  columns.each do |d|
    if d
      if d.day == now.day
        printf('%s%3d%s', REVERSE, d.day, RESET)
      else
        printf('%3d', d.day)
      end

      printf('%s%3d%s ', CYAN, mail_count(d), RESET)
    else
      print '       '
    end
  end
  puts
end
