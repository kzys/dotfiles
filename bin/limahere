#! /usr/bin/env python3
"""Start (or create) a Lima VM that writable-mounts the current directory,
then open a shell inside it at the same path."""

import argparse
import json
import os
import re
import subprocess
import sys

# apt packages installed into every newly created VM. Edit to taste.
# (curl is needed by the Claude Code installer below.)
PACKAGES = ["build-essential", "curl"]


def provisions():
    """Provision steps run on first boot, in order."""
    apt = (
        "#!/bin/sh\n"
        "set -eux\n"
        "export DEBIAN_FRONTEND=noninteractive\n"
        "apt-get update\n"
        "apt-get install -y " + " ".join(PACKAGES) + "\n"
    )
    # Install Claude Code per-user via its official installer.
    claude = (
        "#!/bin/sh\n"
        "set -eux\n"
        "curl -fsSL https://claude.ai/install.sh | bash\n"
    )
    return [
        {"mode": "system", "script": apt},
        {"mode": "user", "script": claude},
    ]


def instance_name(path):
    """Derive a valid Lima instance name from a directory's basename."""
    name = re.sub(r"[^a-z0-9-]", "-", os.path.basename(path).lower())
    name = name.strip("-")
    if not name or not name[0].isalnum():
        name = "lima-" + name
    return name


def existing_instances():
    out = subprocess.run(
        ["limactl", "list", "-q"], check=True, capture_output=True, text=True
    )
    return out.stdout.split()


def status(name):
    out = subprocess.run(
        ["limactl", "list", "--format", "{{.Status}}", name],
        check=True,
        capture_output=True,
        text=True,
    )
    return out.stdout.strip()


def create(name, here):
    # Base on the default template, but replace its mounts so the guest
    # sees *only* this directory (not the whole home directory).
    mounts = json.dumps([{"location": here, "writable": True}])
    provision = json.dumps(provisions())
    subprocess.run(
        [
            "limactl", "start", "--tty=false", "--name", name,
            "--set", f".mounts = {mounts} | .provision = {provision}",
            "template://default",
        ],
        check=True,
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--provision",
        action="store_true",
        help="delete any existing VM for this directory and create a fresh one",
    )
    args = parser.parse_args()

    here = os.getcwd()
    name = instance_name(here)

    if args.provision and name in existing_instances():
        subprocess.run(["limactl", "delete", "--force", name], check=True)

    if name not in existing_instances():
        create(name, here)
    elif status(name) != "Running":
        subprocess.run(["limactl", "start", name], check=True)

    os.execvp(
        "limactl", ["limactl", "shell", "--workdir", here, name]
    )


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
