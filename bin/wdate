#! /usr/bin/env python3
"""Print a world map in Braille, shaded by local solar time, plus a clock list.

Land is tinted by the local solar time at its longitude using a cool-to-warm
ramp (blue at night, orange at midday) that stays legible on both light and
dark terminals. City markers and a clock list are printed below. City
coordinates are resolved from the IANA tz database (zone1970.tab) by zone name.

Usage: wdate [WIDTH]   (WIDTH = map width in characters, default 60)

Coastline data is Natural Earth 110m land, downloaded once and cached under
~/.cache/wdate/.
"""
import json
import os
import re
import sys
import urllib.request
from datetime import datetime, timezone
from zoneinfo import ZoneInfo

CACHE_DIR = os.path.expanduser("~/.cache/wdate")
CACHE_FILE = os.path.join(CACHE_DIR, "ne_110m_land.geojson")
DATA_URL = ("https://raw.githubusercontent.com/nvkelso/natural-earth-vector/"
            "master/geojson/ne_110m_land.geojson")

# tzdata zones; label and coordinates are both resolved from the zone name.
# A balanced spread of major hubs, plus a standalone UTC reference line.
CITIES = [
    "UTC",
    "America/Los_Angeles",   # US west
    "America/New_York",      # US east
    "Europe/London",         # Europe
    "Asia/Dubai",            # Gulf
    "Asia/Singapore",        # SE Asia
    "Asia/Tokyo",            # East Asia
    "Australia/Sydney",      # Oceania
]
RESET = "\033[0m"

# crop to the inhabited latitude band (drops empty Arctic and Antarctica)
LAT_MAX = 84.0
LAT_MIN = -56.0


def zone_label(tz):
    # "America/Los_Angeles" -> "Los Angeles"; "UTC" -> "UTC"
    return tz.rsplit("/", 1)[-1].replace("_", " ")
BLANK = "⠀"  # empty braille cell (ocean)

# local-solar-time -> cool/warm temperature ramp (blue night -> orange midday).
# Mid-luminance, saturated colors stay legible on both light and dark terminals
# (unlike a grayscale brightness ramp, which only contrasts with one).
TIME_BANDS = [
    (5,  "38;5;25"),   # night    (blue)
    (7,  "38;5;67"),   # dawn     (slate blue)
    (11, "38;5;173"),  # morning  (terracotta)
    (14, "38;5;208"),  # midday   (orange)
    (18, "38;5;173"),  # afternoon
    (21, "38;5;67"),   # dusk
    (24, "38;5;25"),   # night
]


def band_color(solar_hour):
    for upper, color in TIME_BANDS:
        if solar_hour < upper:
            return color
    return TIME_BANDS[-1][1]


def marker_color(lon, utc_hour):
    # opposite of the land's local-time tint (the band 12 hours away), so a
    # marker always contrasts with the shade it sits on
    solar = (utc_hour + lon / 15.0) % 24.0
    return band_color((solar + 12.0) % 24.0)


def load_land():
    if not os.path.exists(CACHE_FILE):
        os.makedirs(CACHE_DIR, exist_ok=True)
        urllib.request.urlretrieve(DATA_URL, CACHE_FILE)
    with open(CACHE_FILE) as f:
        return json.load(f)


def _parse_iso6709(s):
    # e.g. "+404251-0740023" -> (40.7142, -74.0064); seconds are optional
    m = re.match(r"^([+-]\d{2})(\d{2})(\d{2})?([+-]\d{3})(\d{2})(\d{2})?$", s)
    if not m:
        return None

    def dms(deg, mm, ss):
        sign = -1 if deg[0] == "-" else 1
        return sign * (abs(int(deg)) + int(mm) / 60 + (int(ss or 0) / 3600))

    return dms(m[1], m[2], m[3]), dms(m[4], m[5], m[6])


def tz_coords():
    """Map each IANA zone to its reference-city (lat, lon) from the tz db.

    Reads zone1970.tab first, then zone.tab as a fallback for zones the newer
    table merged away (e.g. Atlantic/Reykjavik); the first hit wins.
    """
    base = os.environ.get("TZDIR", "/usr/share/zoneinfo")
    coords = {}
    for tab in ("zone1970.tab", "zone.tab"):
        path = os.path.join(base, tab)
        if not os.path.exists(path):
            continue
        with open(path) as f:
            for line in f:
                if line.startswith("#"):
                    continue
                parts = line.rstrip("\n").split("\t")
                if len(parts) < 3:
                    continue
                latlon = _parse_iso6709(parts[1])
                if latlon:
                    coords.setdefault(parts[2], latlon)
    return coords


def render_map(chars_w, utc_hour, coords):
    # Braille cell = 2px wide x 4px tall. Pixel height tracks the cropped
    # latitude span so the equirectangular aspect ratio stays undistorted.
    px_w = chars_w * 2
    lat_span = LAT_MAX - LAT_MIN
    px_h = max(1, round(px_w * lat_span / 360.0))
    chars_h = (px_h + 3) // 4
    grid = [[0] * px_w for _ in range(px_h)]

    def project(lon, lat):
        x = (lon + 180.0) / 360.0 * (px_w - 1)
        y = (LAT_MAX - lat) / lat_span * (px_h - 1)
        return x, y

    def fill_polygon(rings):
        # even-odd scanline fill; multiple rings handle holes
        edges = []
        ymin, ymax = px_h, 0
        for ring in rings:
            pts = [project(lon, lat) for lon, lat in ring]
            for i in range(len(pts) - 1):
                edges.append((pts[i], pts[i + 1]))
            for _, y in pts:
                ymin = min(ymin, int(y))
                ymax = max(ymax, int(y))
        ymin = max(ymin, 0)
        ymax = min(ymax, px_h - 1)
        for py in range(ymin, ymax + 1):
            yc = py + 0.5
            xs = []
            for (x0, y0), (x1, y1) in edges:
                if (y0 <= yc < y1) or (y1 <= yc < y0):
                    xs.append(x0 + (yc - y0) / (y1 - y0) * (x1 - x0))
            xs.sort()
            for i in range(0, len(xs) - 1, 2):
                a = max(int(xs[i] + 0.5), 0)
                b = min(int(xs[i + 1] + 0.5), px_w - 1)
                for px in range(a, b + 1):
                    grid[py][px] = 1

    for feat in load_land()["features"]:
        geom = feat["geometry"]
        polys = (geom["coordinates"] if geom["type"] == "MultiPolygon"
                 else [geom["coordinates"]])
        for poly in polys:
            fill_polygon(poly)

    # Braille dot bit layout for a 2x4 cell
    dot = [[0x01, 0x08], [0x02, 0x10], [0x04, 0x20], [0x40, 0x80]]
    cells = []
    for cy in range(chars_h):
        row = []
        for cx in range(chars_w):
            bits = 0
            for dy in range(4):
                for dx in range(2):
                    py, px = cy * 4 + dy, cx * 2 + dx
                    if py < px_h and px < px_w and grid[py][px]:
                        bits |= dot[dy][dx]
            row.append(chr(0x2800 + bits))
        cells.append(row)

    # tint each land cell by its column's local solar time
    col_color = []
    for cx in range(chars_w):
        lon = (cx * 2 + 1) / (px_w - 1) * 360.0 - 180.0
        solar = (utc_hour + lon / 15.0) % 24.0
        col_color.append(band_color(solar))
    for row in cells:
        for cx, glyph in enumerate(row):
            if glyph != BLANK:
                row[cx] = f"\033[{col_color[cx]}m{glyph}{RESET}"

    # overlay each city marker in the complement of its local-time tint
    for tz in CITIES:
        loc = coords.get(tz)
        if loc is None:
            continue
        lat, lon = loc
        x, y = project(lon, lat)
        cx, cy = int(x) // 2, int(y) // 4
        if 0 <= cy < chars_h and 0 <= cx < chars_w:
            cells[cy][cx] = f"\033[{marker_color(lon, utc_hour)}m◉{RESET}"

    return "\n".join("".join(row).rstrip() for row in cells)


def render_clock(coords, utc_hour):
    # location-less rows (e.g. UTC) first as a reference, then cities ordered
    # west-to-east so the list matches the markers' left-to-right positions
    located = sorted((tz for tz in CITIES if tz in coords),
                     key=lambda tz: coords[tz][1])
    other = [tz for tz in CITIES if tz not in coords]
    lines = []
    for tz in other + located:
        t = datetime.now(ZoneInfo(tz))
        if tz in coords:
            marker = f"\033[{marker_color(coords[tz][1], utc_hour)}m◉{RESET}"
        else:
            marker = " "
        lines.append(f"{marker} {zone_label(tz):<14} {t:%Y-%m-%d %H:%M  %Z} "
                     f"(UTC{t:%z})")
    return "\n".join(lines)


def main():
    width = int(sys.argv[1]) if len(sys.argv) > 1 else 60
    now = datetime.now(timezone.utc)
    utc_hour = now.hour + now.minute / 60.0
    coords = tz_coords()
    print(render_map(width, utc_hour, coords))
    print()
    print(render_clock(coords, utc_hour))


if __name__ == "__main__":
    main()
