#!/bin/sh
# Pick a project under ~/project with fzf, or a new one, and start
# bin/claude-ask there in a new Herdr workspace. Each project is listed
# with the title from the front matter of its README.md, and its
# workspace is labeled with the name from there. Projects open in Herdr
# are marked, and Enter switches to them. Otherwise Enter resumes the
# project's latest claude session, if any. A background session is
# stopped and resumed in the workspace if idle, and attached otherwise.

set -eu

herdr=${HERDR_BIN_PATH:-herdr}
projects=$HOME/project
mkdir -p "$projects"
front_matter=$(dirname "$0")/herdr-front-matter

# Succeeds if claude has a session for directory $1. Claude keeps them
# under ~/.claude/projects, in a directory named after the path.
has_session() {
    set -- "$HOME/.claude/projects/$(printf '%s' "$1" | sed 's/[^a-zA-Z0-9]/-/g')"/*.jsonl
    [ -f "$1" ]
}

# Prints the ID, session ID, and status of the latest background claude
# session started in directory $1, if any.
background() {
    claude agents --json --cwd "$1" 2>/dev/null |
        jq -r --arg cwd "$1" '[.[] | select(.kind == "background" and .cwd == $cwd)] |
            max_by(.startedAt) | values | "\(.id) \(.sessionId) \(.status)"'
}

# Workspace and directory of each pane open in Herdr.
open=$("$herdr" pane list | jq -r '.result.panes[] | "\(.workspace_id)\t\(.cwd)"')

# Prints the workspace of a pane open in directory $1 or under it, if
# any.
workspace_of() {
    printf '%s\n' "$open" |
        awk -F '\t' -v dir="$1" '$2 == dir || index($2, dir "/") == 1 { print $1; exit }'
}

# Fields: directory, then what fzf shows. Directory names start with
# the date, so reverse order puts the newest projects first. The first
# line of the output is the key pressed, empty for Enter.
out=$({
    printf 'new\t  + new project\n'
    for dir in "$projects"/*/; do
        [ -d "$dir" ] || continue
        dir=${dir%/}
        if summary=$("$front_matter" "$dir" title); then
            [ -n "$summary" ] || summary='(no title)'
        else
            summary='(no notes)'
        fi
        mark=' '
        [ -z "$(workspace_of "$dir")" ] || mark='●'
        printf '%s\t%s %s  %s\n' "$dir" "$mark" "${dir##*/}" "$summary"
    done | sort -r
} | fzf --reverse --delimiter='\t' --with-nth=2.. --prompt='project> ' \
    --header='enter: switch or resume  ctrl-]: new session  ctrl-\: pick session' \
    --expect="ctrl-],ctrl-\\" \
    --preview='cd {1} 2>/dev/null && cat README.md NOTES.md AGENT-*.md 2>/dev/null' \
    --preview-window=down,50%) ||
    exit 0
key=$(printf '%s\n' "$out" | sed -n 1p)
selected=$(printf '%s\n' "$out" | sed -n 2p | cut -f1)
[ -n "$selected" ] || exit 0

if [ "$selected" = new ]; then
    selected=$(mktemp -d "$projects/$(date +%Y%m%d)-XXXXXX")
fi

cmd="'$HOME/ws/dotfiles/bin/claude-ask'"
case $key in
ctrl-]) ;;
"ctrl-\\") has_session "$selected" && cmd="$cmd --resume" ;;
*)
    workspace=$(workspace_of "$selected")
    if [ -n "$workspace" ]; then
        "$herdr" workspace focus "$workspace" >/dev/null
        "$front_matter" --report "$workspace" "$selected" || true
        exit
    fi
    read -r id session status <<EOF
$(background "$selected")
EOF
    if [ "$status" = idle ] && claude stop "$id" >/dev/null; then
        cmd="$cmd --resume $session"
    elif [ -n "$id" ]; then
        cmd="claude attach $id"
    elif has_session "$selected"; then
        cmd="$cmd --continue"
    fi
    ;;
esac

name=$("$front_matter" "$selected" name || true)
created=$("$herdr" workspace create --cwd "$selected" ${name:+--label "$name"} --focus)
pane=$(printf '%s' "$created" | jq -r .result.root_pane.pane_id)
"$front_matter" --report \
    "$(printf '%s' "$created" | jq -r .result.workspace.workspace_id)" "$selected" || true
"$herdr" pane run "$pane" "$cmd" >/dev/null
