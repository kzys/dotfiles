#!/bin/sh
# herdr-adopt [--agent <claude|codex>] picks Claude background sessions, or
# saved Codex ones, and opens each in Herdr.

here=$(dirname "$(readlink -f "$0")")
case "$*" in
*codex*) ;;
*) exec "$here/claude-adopt" ;;
esac
socket=${XDG_STATE_HOME:-$HOME/.local/state}/herdr-project/run/server.sock
curl --silent --fail --max-time 30 --unix-socket "$socket" 'http://localhost/sessions?list=codex' |
    jq -r '.[] | [.id, ([.name, .title] | map(select(. != null and . != "")) | .[0] // "(untitled)"), .cwd] | @tsv' |
    fzf --multi --reverse --delimiter='	' --with-nth=2.. --prompt='adopt> ' |
    while IFS='	' read -r id _ cwd; do
        [ -d "$cwd" ] || continue
        jq -n --arg id "codex:$id" --arg cwd "$cwd" '{row: ["session", $cwd, $id, ""], agent: "codex"}' |
            curl --silent --fail --unix-socket "$socket" --header 'Content-Type: application/json' \
                --data-binary @- http://localhost/picker/open
    done
