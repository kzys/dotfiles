escape ^z^z
bind ^a other
vbell off
startup_message off
autodetach on

# show selected window on title-bar
termcapinfo xterm* "hs:ts=\E]2;:fs=\007:ds=\E]0"
hardstatus string "%t"
msgwait 1

# show all window on bottom
caption always " %-w%{= d.}%n:%t%{-}%+w"

## disable keys
# lock screen
bind ^X
bind x
# bell
bind ^G
bind g

# don't use flow control
defflow off

# C-z . -> reload ~/.screenrc
bind . eval "source $HOME/.screenrc"

defencoding utf-8

# emacs-like copy mode
markkeys h=^b:l=^f:$=^e
