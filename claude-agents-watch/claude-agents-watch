#! /usr/bin/env python3
"""Show Claude Code sessions in a small window, refreshed from
`claude agents --json` and each session's transcript under
~/.claude/projects.

Needs only python3 with tkinter. On macOS the Homebrew python has it via
`brew install python-tk`; the Linux package is usually python3-tk.
"""

import argparse
import json
import os
import queue
import subprocess
import threading
import tkinter as tk
from datetime import datetime, timezone
from tkinter import font as tkfont
from tkinter import ttk

from transcripts import Transcripts
from windows import Windows

# Row colours by tag, the only place state is shown. Anything else falls
# back to the default foreground. "full" is a nearly exhausted context window,
# a brighter red than a failure so the two stay apart.
ROW_COLORS = {
    "working": "#1a7f37",
    "blocked": "#b35c00",
    "failed": "#c0392b",
    "done": "#6e7781",
    "full": "#e5534b",
}

# Percent of the context window that turns a row red.
CONTEXT_FULL_PCT = 90

# The columns compact mode leaves on show, in display order.
COMPACT_COLUMNS = ("mark", "name", "model", "context")

# Smallest window the full column set is usable in. Compact mode drops the
# floor, since the point of it is a window narrower than that.
FULL_MIN_WIDTH = 600
MIN_HEIGHT = 60

# Animation frames for the mark column, one frame per tick. A waving hand for
# sessions waiting on the user, a runner for the ones still going: both states
# are worth an eye, and only motion catches one. Single-codepoint emoji only,
# so every frame is the same width and the column can't jitter.
WAVE = ["👋"] * 2 + ["🖐"] * 2
RUN = ["🚶"] * 2 + ["🏃"] * 2
TICK_MS = 150


def fetch(show_all):
    """Run `claude agents --json` and return its list, or raise."""
    cmd = ["claude", "agents", "--json"]
    if show_all:
        cmd.append("--all")
    out = subprocess.run(cmd, capture_output=True, text=True, check=True)
    return json.loads(out.stdout)


def version():
    """Claude Code's version, e.g. "2.1.274", or "" if unavailable."""
    try:
        out = subprocess.run(["claude", "--version"], capture_output=True,
                             text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return ""
    return out.split()[0] if out.split() else ""


def poll(show_all, interval, results, stop):
    """Fetch forever on a thread, posting (sessions, error) to results.
    Transcript details are merged into each session under "transcript".
    The first item posted is (version, None) instead."""
    results.put((version(), None))
    transcripts = Transcripts()
    windows = Windows()
    while not stop.is_set():
        try:
            sessions = fetch(show_all)
            for a in sessions:
                try:
                    a["transcript"] = transcripts.info(a.get("sessionId", ""))
                except OSError:
                    a["transcript"] = {}
                model = a["transcript"].get("model")
                if model:
                    a["transcript"]["window"] = windows.get(model)
            results.put((sessions, None))
        except Exception as e:  # subprocess or JSON failure; show it, keep going
            results.put((None, str(e).strip() or type(e).__name__))
        stop.wait(interval)


def duration(seconds):
    """Coarse age, so a value changes at most once a minute."""
    s = int(seconds)
    if s < 60:
        return "now"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h"
    return f"{s // 86400}d"


def since(iso):
    """Seconds since an ISO-8601 timestamp like 2026-09-16T01:39:29.123Z."""
    t = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    return (datetime.now(timezone.utc) - t).total_seconds()


def short_cwd(path):
    """Abbreviate cwd for display: ~ for $HOME and [name] for a worktree."""
    home = os.path.expanduser("~")
    if path == home or path.startswith(home + os.sep):
        path = "~" + path[len(home):]
    repo, sep, name = path.partition("/.claude/worktrees/")
    if sep:
        path = f"{repo} [{name}]"
    return path


def context(tokens, window):
    """Context size as "147k 15%", or just "147k" if the window is unknown."""
    if not tokens:
        return ""
    s = f"{round(tokens / 1000)}k"
    if window:
        s += f" {round(100 * tokens / window)}%"
    return s


def first_line(text, limit=120):
    text = text.strip().split("\n", 1)[0]
    return text if len(text) <= limit else text[:limit - 1] + "…"


def context_full(tokens, window):
    """Whether a session has used enough of its window to be worth warning
    about. Unknown numbers are not a warning."""
    if not tokens or not window:
        return False
    return 100 * tokens / window > CONTEXT_FULL_PCT


def row_tag(a):
    """The tag that colours a row. A nearly full context window outranks the
    state: the state says what the session is doing, this says it is about to
    stop being able to."""
    t = a.get("transcript") or {}
    if context_full(t.get("context"), t.get("window")):
        return "full"
    return a.get("state") or ""


# How much a state wants the user, low first. States not listed fall back to
# the status and the pid, which is all an interactive session reports.
STATE_RANK = {"blocked": 0, "working": 2, "done": 3, "failed": 3}


def rank(a):
    """Sort rank for a session: waiting on the user, idle, running, finished."""
    state = a.get("state") or ""
    if state in STATE_RANK:
        return STATE_RANK[state]
    if a.get("status") == "waiting":
        return 0
    if a.get("status") == "busy":
        return 2
    return 1 if a.get("pid") is not None else 3


def last_seen(a):
    """Seconds since the session last wrote to its transcript, or infinity when
    it has none, so a session with no activity to show sorts last."""
    last = (a.get("transcript") or {}).get("last")
    return since(last) if last else float("inf")


def sort_key(a):
    # Sessions that want the user first, then most recently active in a rank.
    return (rank(a), last_seen(a))


def mark(a, frame):
    """Marker for a session: a wave when it wants the user, a runner while it
    runs, nothing when it is idle or finished. Interactive sessions report only
    a status, background ones a state, so both spellings mean running."""
    if a.get("state") == "blocked":
        return WAVE[frame % len(WAVE)]
    if a.get("state") == "working" or a.get("status") == "busy":
        return RUN[frame % len(RUN)]
    return ""


class App:
    def __init__(self, root, args):
        self.root = root
        self.args = args
        self.sessions = []
        self.results = queue.Queue()
        self.stop = threading.Event()
        self.frame = 0
        self.rows = 0
        self.compact = False
        self.full_width = None

        root.title("claude agents")
        root.attributes("-topmost", args.topmost)
        root.bind("t", self.toggle_topmost)
        root.bind("c", self.toggle_compact)
        root.bind("q", lambda e: self.quit())
        root.protocol("WM_DELETE_WINDOW", self.quit)

        # Packed first so the tree can't squeeze it out of a small window.
        self.status = tk.StringVar()
        self.version = ""
        bar = ttk.Frame(root)
        bar.pack(side="bottom", fill="x")
        ttk.Label(bar, textvariable=self.status, anchor="w",
                  padding=(4, 2)).pack(side="left", fill="x", expand=True)
        # A fixed width, so the label doesn't shift when the text changes.
        self.compact_button = ttk.Button(bar, text="Compact", width=8,
                                         command=self.toggle_compact)
        self.compact_button.pack(side="right", padx=4, pady=2)

        # ttk's default row height ignores the font and clips it on HiDPI.
        self.font = tkfont.nametofont("TkDefaultFont")
        linespace = self.font.metrics("linespace")
        ttk.Style().configure("Treeview", rowheight=linespace + 10)

        # Widths are placeholders until fit() sizes them to their content.
        # Only the prompt stretches, so ttk hands it whatever is left over
        # when the other columns or the window change size.
        # redraw() builds each row positionally, so keep the two in lockstep.
        columns = (
            ("mark", "", 34),
            ("name", "Name", 220),
            ("model", "Model", 70),
            ("context", "Context", 100),
            ("prompt", "Last prompt", 300),
            ("last", "Last", 50),
            ("cwd", "Directory", 200),
            ("branch", "Branch", 120),
        )
        self.tree = ttk.Treeview(root, columns=[c[0] for c in columns],
                                 show="headings")
        for col, title, width in columns:
            self.tree.heading(col, text=title)
            self.tree.column(col, width=width, stretch=col == "prompt",
                             anchor="e" if col in ("last", "context") else "w")
        self.tree.column("prompt", minwidth=100)
        for tag, color in ROW_COLORS.items():
            self.tree.tag_configure(tag, foreground=color)
        self.tree.pack(fill="both", expand=True)

        # On X11 alpha only sticks once the window is mapped.
        root.update_idletasks()
        root.attributes("-alpha", args.alpha)

        threading.Thread(
            target=poll,
            args=(args.all, args.interval, self.results, self.stop),
            daemon=True,
        ).start()
        self.tick()

    def toggle_topmost(self, _event=None):
        self.root.attributes("-topmost", not self.root.attributes("-topmost"))

    def toggle_compact(self, _event=None):
        """Show either every column or just the status, name, model and
        context. The window narrows to what is left and widens back to the
        width it had, since compact columns in a wide window are mostly gap."""
        self.compact = not self.compact
        if self.compact:
            self.full_width = self.root.winfo_width()
        self.tree.configure(
            displaycolumns=COMPACT_COLUMNS if self.compact else "#all")
        self.root.minsize(1 if self.compact else FULL_MIN_WIDTH, MIN_HEIGHT)
        # Measure before stretching name: a stretched column fills whatever
        # width the window already has, which would just measure that back.
        self.root.update_idletasks()
        width = self.root.winfo_reqwidth() if self.compact else self.full_width
        # Only the prompt stretches, and it is hidden here, so name takes over.
        self.tree.column("name", stretch=self.compact)
        self.compact_button.configure(
            text="Full" if self.compact else "Compact")
        self.root.geometry(f"{width}x{self.root.winfo_height()}")

    def quit(self):
        self.stop.set()
        self.root.destroy()

    def tick(self):
        """Apply any poll results, then redraw to advance markers and ages."""
        changed = False
        try:
            while True:
                item, err = self.results.get_nowait()
                if err is not None:
                    self.status.set(f"error: {err}")
                    continue
                if isinstance(item, str):
                    self.version = item
                else:
                    self.sessions = sorted(item, key=sort_key)
                    changed = True
                n = len(self.sessions)
                parts = [f"{n} session{'' if n == 1 else 's'}"]
                if self.version:
                    parts.append(f"claude {self.version}")
                self.status.set("  ·  ".join(parts))
        except queue.Empty:
            pass
        self.frame += 1
        self.redraw()
        if changed:
            self.fit()
        self.root.after(TICK_MS, self.tick)

    def fit(self):
        """Size each column to its widest cell; the prompt takes the rest.
        The window height follows the row count; the width is left alone."""
        for col in self.tree["columns"]:
            if col in ("mark", "prompt"):
                continue
            texts = [self.tree.heading(col, "text")]
            texts += [self.tree.set(iid, col) for iid in self.tree.get_children()]
            width = max(self.font.measure(t) for t in texts) + 16
            self.tree.column(col, width=width)

        rows = max(1, len(self.sessions))
        if rows != self.rows:
            self.rows = rows
            self.tree.configure(height=rows)
            self.root.update_idletasks()
            height = min(self.root.winfo_reqheight(),
                         self.root.winfo_screenheight() * 3 // 4)
            self.root.geometry(f"{self.root.winfo_width()}x{height}")

    def redraw(self):
        """Sync tree rows to self.sessions, keyed by session id so the
        selection survives refreshes."""
        seen = set()
        for i, a in enumerate(self.sessions):
            iid = a.get("id") or a.get("sessionId")
            seen.add(iid)
            t = a.get("transcript") or {}
            values = (
                mark(a, self.frame),
                a.get("name") or "(untitled)",
                (t.get("model") or "").removeprefix("claude-"),
                context(t.get("context"), t.get("window")),
                first_line(t.get("prompt") or ""),
                duration(since(t["last"])) if t.get("last") else "",
                short_cwd(a.get("cwd") or ""),
                t.get("branch") or "",
            )
            if self.tree.exists(iid):
                self.tree.item(iid, values=values, tags=(row_tag(a),))
                self.tree.move(iid, "", i)
            else:
                self.tree.insert("", i, iid=iid, values=values, tags=(row_tag(a),))
        for iid in self.tree.get_children():
            if iid not in seen:
                self.tree.delete(iid)

        blocked = sum(1 for a in self.sessions if a.get("state") == "blocked")
        busy = sum(1 for a in self.sessions if a.get("status") == "busy")
        counts = [f"{n} {what}" for n, what in ((blocked, "blocked"), (busy, "busy")) if n]
        self.root.title(f"claude agents ({', '.join(counts)})" if counts else "claude agents")


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    p.add_argument("--live", dest="all", action="store_false",
                   help="hide completed background sessions")
    p.add_argument("--interval", type=float, default=2.0, metavar="SEC",
                   help="seconds between refreshes (default: 2)")
    p.add_argument("--no-topmost", dest="topmost", action="store_false",
                   help="don't keep the window above others (t toggles)")
    p.add_argument("--alpha", type=float, default=0.9, metavar="A",
                   help="window opacity, 0 to 1 (default: 0.9)")
    args = p.parse_args()

    root = tk.Tk()
    root.geometry("1100x240")
    root.minsize(FULL_MIN_WIDTH, MIN_HEIGHT)
    App(root, args)
    root.mainloop()


if __name__ == "__main__":
    main()
