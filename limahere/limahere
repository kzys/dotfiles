#! /usr/bin/env python3
"""Start (or create) a Lima VM that writable-mounts the current directory,
then open a shell inside it at the same path."""

import argparse
import json
import os
import re
import subprocess
import sys

# Resolve symlinks so the *.sh files are found when invoked via bin/limahere.
HERE = os.path.dirname(os.path.realpath(__file__))

# Host config files copied into the guest's home so the shell and Claude Code
# start configured. Paths are relative to the host's home, and are placed at
# the same relative path inside the guest's home. Symlinks are followed and
# missing files are skipped.
CONFIG_FILES = [
    ".zshrc",
    ".tmux.conf",
    ".claude.json",
    ".claude/settings.json",
    # .claude/.credentials.json is NOT here: on macOS Claude's login lives in
    # the keychain, not that file (which is what Claude reads on Linux);
    # seed_claude_auth() reads the keychain and writes the guest file.
    # gh's prefs (git_protocol, user). The token is NOT in hosts.yml on macOS
    # (it lives in the keychain); seed_gh_auth() injects it separately.
    ".config/gh/config.yml",
    ".config/gh/hosts.yml",
]

# A single fully-provisioned base VM. Per-directory VMs are cloned from its
# disk instead of re-running provisioning (apt, Go, Claude, zsh) every time,
# which is the slow part of a fresh create. Rebuild it with --clean after
# changing system.sh/user.sh.
GOLDEN = "limahere-golden"


def provisions():
    """Provision steps run on first boot, in order."""
    steps = []
    for mode in ("system", "user"):
        with open(os.path.join(HERE, f"{mode}.sh")) as f:
            steps.append({"mode": mode, "script": f.read()})
    return steps


def instance_name(path):
    """Derive a valid Lima instance name from a directory's basename."""
    name = re.sub(r"[^a-z0-9-]", "-", os.path.basename(path).lower())
    name = name.strip("-")
    if not name or not name[0].isalnum():
        name = "lima-" + name
    return name


def existing_instances():
    out = subprocess.run(
        ["limactl", "list", "-q"], check=True, capture_output=True, text=True
    )
    return out.stdout.split()


def status(name):
    out = subprocess.run(
        ["limactl", "list", "--format", "{{.Status}}", name],
        check=True,
        capture_output=True,
        text=True,
    )
    return out.stdout.strip()


def build_golden():
    """Provision the shared base VM once: apt packages, Go, Claude Code, zsh
    login shell — all baked into its disk. It has no host mount (clones add
    their own) and is left stopped so it can be cloned consistently."""
    provision = json.dumps(provisions())
    # Run containerd as root (system) instead of the default rootless user.
    sets = (
        f".mounts = [] | .provision = {provision}"
        " | .containerd.system = true | .containerd.user = false"
    )
    subprocess.run(
        [
            "limactl", "start", "--tty=false", "--progress", "--name", GOLDEN,
            "--set", sets,
            "template://default",
        ],
        check=True,
    )
    subprocess.run(["limactl", "stop", GOLDEN], check=True)


def create(name, here):
    # Clone the fully-provisioned golden disk instead of re-provisioning.
    if GOLDEN not in existing_instances():
        build_golden()
    elif status(GOLDEN) == "Running":
        # clone needs the source stopped for a consistent disk copy.
        subprocess.run(["limactl", "stop", GOLDEN], check=True)

    # Replace the (empty) golden mounts with *only* this directory, and drop
    # .provision: it already ran in golden and is baked into the cloned disk.
    subprocess.run(
        [
            "limactl", "clone", "--tty=false", "--start",
            "--mount-only", f"{here}:w",
            "--set", ".provision = []",
            GOLDEN, name,
        ],
        check=True,
    )

    # Lima sets the guest hostname from the instance name via cloud-init, which
    # doesn't re-run on the cloned disk; reset it so %m (and the lima- prompt
    # highlight) reflect this VM, not the golden one.
    subprocess.run(
        ["limactl", "shell", name, "sudo", "hostnamectl", "set-hostname",
         f"lima-{name}"],
        check=True,
    )


def guest_home(name):
    out = subprocess.run(
        ["limactl", "shell", name, "sh", "-c", "echo $HOME"],
        check=True,
        capture_output=True,
        text=True,
    )
    return out.stdout.strip()


def seed_config(name):
    """Copy host config (CONFIG_FILES) into the guest's home."""
    host_home = os.path.expanduser("~")
    home = guest_home(name)
    dirs = {os.path.dirname(f) for f in CONFIG_FILES if os.path.dirname(f)}
    for d in sorted(dirs):
        subprocess.run(
            ["limactl", "shell", name, "mkdir", "-p", f"{home}/{d}"],
            check=True,
        )
    for rel in CONFIG_FILES:
        src = os.path.join(host_home, rel)
        if not os.path.exists(src):
            continue
        # Dereference symlinks (e.g. ~/.zshrc -> the dotfiles repo) so the
        # file's content is copied, not a link that dangles in the guest.
        src = os.path.realpath(src)
        subprocess.run(
            ["limactl", "copy", src, f"{name}:{home}/{rel}"],
            check=True,
        )


def seed_gh_auth(name):
    """Authenticate gh in the guest with the host's token.

    On macOS the token lives in the keychain (not hosts.yml), so we read it
    via `gh auth token` and pipe it into the guest's `gh auth login
    --with-token`, which merges it into the seeded hosts.yml as plaintext
    (the guest has no keyring). Skipped if the host has no usable token."""
    try:
        out = subprocess.run(
            ["gh", "auth", "token"], capture_output=True, text=True
        )
    except FileNotFoundError:
        return
    token = out.stdout.strip()
    if out.returncode != 0 or not token:
        return
    subprocess.run(
        ["limactl", "shell", name, "gh", "auth", "login", "--with-token"],
        input=token + "\n",
        text=True,
        check=True,
    )


def seed_claude_auth(name):
    """Seed Claude Code's login into the guest.

    On macOS the OAuth credentials live in the login keychain, not in
    ~/.claude/.credentials.json (which is what Claude reads on Linux). Read the
    keychain payload and write it to the guest's file with the 600 perms Claude
    expects. Skipped if the host has no keychain entry (e.g. not logged in, or
    a non-macOS host where seed_config already copied the file)."""
    out = subprocess.run(
        ["security", "find-generic-password",
         "-s", "Claude Code-credentials", "-w"],
        capture_output=True,
        text=True,
    )
    creds = out.stdout.strip()
    if out.returncode != 0 or not creds:
        return
    home = guest_home(name)
    subprocess.run(
        ["limactl", "shell", name, "sh", "-c",
         f"cat > {home}/.claude/.credentials.json && "
         f"chmod 600 {home}/.claude/.credentials.json"],
        input=creds + "\n",
        text=True,
        check=True,
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--provision",
        action="store_true",
        help="delete any existing VM for this directory and re-clone it",
    )
    parser.add_argument(
        "--clean",
        action="store_true",
        help="delete the golden base VM so it is re-provisioned (use after "
             "changing system.sh/user.sh)",
    )
    args = parser.parse_args()

    here = os.getcwd()
    name = instance_name(here)

    if args.clean and GOLDEN in existing_instances():
        subprocess.run(["limactl", "delete", "--force", GOLDEN], check=True)

    if args.provision and name in existing_instances():
        subprocess.run(["limactl", "delete", "--force", name], check=True)

    if name not in existing_instances():
        create(name, here)
    elif status(name) != "Running":
        subprocess.run(["limactl", "start", name], check=True)

    seed_config(name)
    seed_gh_auth(name)
    seed_claude_auth(name)

    # ssh forwards $TERM into the guest. The host's terminal (e.g.
    # xterm-ghostty) may have no terminfo entry there, breaking curses apps
    # like top; xterm-256color is universally available (ncurses-base) and
    # gives 256 colors, so force it. (24-bit truecolor comes from COLORTERM,
    # which ssh does NOT forward; the seeded .zshrc sets it in the guest.)
    os.environ["TERM"] = "xterm-256color"

    # Open the interactive login shell with no command: ssh allocates a PTY
    # and forwards $TERM only when no remote command is given, and the login
    # shell is already zsh thanks to the chsh in user.sh.
    os.execvp(
        "limactl", ["limactl", "shell", "--workdir", here, name]
    )


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
