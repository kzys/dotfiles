[core]
	pager = less -R

[log]
	date = local

[grep]
	lineNumber = true
	extendRegexp = true

[push]
    # "simple" is default since Git 2.0
    # http://blogs.atlassian.com/2014/06/happened-git-2-0-full-goodies/
	default = simple

[color]
	ui = auto

[alias]
	b = for-each-ref --sort=-committerdate --format='%(committerdate:short) %(objectname:short) %(refname:short)' refs/heads/
	co = checkout
	dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)\"%an\" <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order
	srcdiff = "!f(){ b=\"${1:-origin/main}\"; shift 2>/dev/null; \\\n  git diff \"$b\"... --name-only | git check-attr --stdin linguist-generated \\\n  | grep \": unspecified$\" | sed \"s/: linguist-generated: unspecified$//\" \\\n  | xargs -r git diff \"$b\"... \"$@\" --; }; f"

[include]
    path = ~/src/dotfiles-private/gitconfig
[credential]
    helper =

[user]
	email = kato.kazuyoshi@gmail.com
	name = Kazuyoshi Kato
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[init]
	defaultBranch = main
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[credential "https://github.com"]
	helper = "!f() { if [ \"$(uname -s)\" = Darwin ]; then /opt/homebrew/bin/gh auth git-credential \"$@\"; else gh auth git-credential \"$@\"; fi; }; f"
# Use HTTPS with gh's credentials for GitHub, even for git@ URLs.
[url "https://github.com/"]
	insteadOf = git@github.com:
